+int GreeterSurface::pollShaderWallpaper() {
+  if (m_shaderWallpaper == nullptr || m_window == nullptr) {
+    return -1;
+  }
+  auto& live = ShaderLive::instance();
+  if (!live.usable()) {
+    if (m_shaderWallpaper->visible()) {
+      m_shaderWallpaper->setVisible(false); // compile or GPU failure: back to the still
+      requestRedraw();
+    }
+    return -1;
+  }
+  if (!m_livePrimed) {
+    // The synced still goes on screen first; the shader takes over once compiled.
+    if (m_framesPrepared == 0) {
+      return 16;
+    }
+    m_livePrimed = true;
+    m_shaderWallpaper->setVisible(true);
+  }
+  const int delay = live.frameDelayMs(this);
+  if (delay != 0) {
+    return delay;
+  }
+  m_shaderWallpaper->invalidate();
+  requestRedraw();
+  const int next = live.frameDelayMs(this);
+  return next == 0 ? 16 : next; // the paint did not happen (deferred); try again shortly
+}
