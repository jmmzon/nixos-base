+void ShaderLiveWallpaper::bindChannels(Program& program, const std::string& source) {
+  const shader::Directives directives = shader::parseDirectives(source);
+  for (std::size_t c = 0; c < 4; ++c) {
+    program.channelImages[c].clear();
+    const shader::ChannelSource& from = directives.channels[c];
+    if (from.kind == shader::ChannelSource::Kind::Unsupported) {
+      kLog.info("{}: iChannel{} wants {}, not supported yet; it reads black", program.spec, c, from.token);
