+const ShaderLiveWallpaper::ChannelTexture& ShaderLiveWallpaper::channelTexture(const std::string& path) {
+  auto [it, inserted] = m_channelTextures.try_emplace(path);
+  ChannelTexture& texture = it->second;
+  if (!inserted) {
+    return texture;
+  }
+  auto image = loadImageFile(path, kMaxChannelImageSize);
+  if (!image.has_value() || image->width <= 0 || image->height <= 0) {
+    kLog.warn("cannot load channel image {}: {}", path, image.has_value() ? "empty image" : image.error());
+    texture.failed = true;
+    return texture;
+  }
+  // Shadertoy's default "vflip": the image's bottom row is texture row 0, so
+  // texture(iChannelN, uv) with uv.y = 0 at the bottom shows it upright.
+  const auto rowBytes = static_cast<std::size_t>(image->width) * 4;
+  std::vector<std::uint8_t> flipped(image->rgba.size());
+  for (int y = 0; y < image->height; ++y) {
+    std::memcpy(
+        flipped.data() + static_cast<std::size_t>(image->height - 1 - y) * rowBytes,
+        image->rgba.data() + static_cast<std::size_t>(y) * rowBytes, rowBytes
+    );
+  }
+  GLint previous = 0;
+  GLint unpackAlignment = 4;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous);
+  glGetIntegerv(GL_UNPACK_ALIGNMENT, &unpackAlignment);
+  glGenTextures(1, &texture.texture);
+  glBindTexture(GL_TEXTURE_2D, texture.texture);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, image->width, image->height, 0, GL_RGBA, GL_UNSIGNED_BYTE, flipped.data());
+  glPixelStorei(GL_UNPACK_ALIGNMENT, unpackAlignment);
+  // Shadertoy's defaults for 2D textures: mipmapped, repeating.
+  glGenerateMipmap(GL_TEXTURE_2D);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
+  glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(previous));
+  texture.width = image->width;
+  texture.height = image->height;
+  kLog.info("channel image {} ({}x{})", path, image->width, image->height);
+  return texture;
+}
