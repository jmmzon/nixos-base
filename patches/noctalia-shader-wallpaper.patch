--- /dev/null
+++ b/src/shell/shader/shader_live_wallpaper.cpp
@@ -0,0 +1,897 @@
+#include "shell/shader/shader_live_wallpaper.h"
+
+#include "core/deferred_call.h"
+#include "core/log.h"
+#include "render/animation/animation.h"
