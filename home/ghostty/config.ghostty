theme = noctalia
# packages/xenon-code: texture healing and ligatures are on in the font itself.
font-family = @fontFamily@
# Dark-mode default; the file below (written by erebor-theme-opacity on each
# Noctalia theme mode change, modules/home/theme-opacity.nix) overrides it.
background-opacity = @appOpacity@
config-file = ?@opacityFile@
# Keep text off the refracting lip of Umbriel's liquid-glass effect.
window-padding-x = 14
window-padding-y = 9
window-padding-balance = true

# Quick (drop-down) terminal, owned by the ghostty-quick-terminal user service
# (modules/home/ghostty.nix): rises from the bottom, half the output tall and
# 80% wide, centred (clear of a side dock), on the output the compositor picks
# (Umbriel: the one under the pointer). Clicking another window hides it; its
# tabs live until the service restarts.
quick-terminal-position = bottom
quick-terminal-size = 50%,80%
quick-terminal-autohide = true
quick-terminal-keyboard-interactivity = on-demand
gtk-quick-terminal-namespace = ghostty-quick-terminal
