index 000000000..d4cfa03b7
--- /dev/null
+++ b/src/shell/live/window_geometry.h
@@ -0,0 +1,70 @@
+#pragma once
+
+// Where windows are on each output, for live wallpapers: a "shader:" wallpaper
+// pauses behind windows ([wallpaper.shader] pause_when_covered) and feeds them to
+// KDE Shader Wallpaper's window-reactive shaders (iWindowRects). A compositor
+// backend publishes snapshots (UmbrielWindowTracker today); consumers read them.
+// The provider only has to keep the snapshot fresh while demand is on.
+//
+// Threading: main thread only.
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+enum class ShaderPause : std::uint8_t;
+
+namespace live {
+
+  // Output-local logical pixels, top-left origin.
+  struct WindowBox {
+    int x = 0;
+    int y = 0;
+    int width = 0;
+    int height = 0;
+
+    bool operator==(const WindowBox&) const = default;
+  };
+
+  struct OutputWindows {
+    int width = 0; // output logical size
+    int height = 0;
+    // Where windows can go (the output minus bars and panels), output-local; empty = the whole output.
+    WindowBox usable;
+    bool fullscreen = false;        // a visible window is fullscreen
+    bool maximized = false;         // a visible window is maximized (or maximized to the edges)
+    std::vector<WindowBox> windows; // visible, unminimized windows (they may extend past the output)
+
+    bool operator==(const OutputWindows&) const = default;
+  };
+
+  // By output connector name ("DP-1").
+  using WindowSnapshot = std::unordered_map<std::string, OutputWindows>;
+
+  // Fraction (0-1) of the output's usable area covered by the union of its windows.
+  double coverage(const OutputWindows& output);
+
+  // The [wallpaper.shader] pause_when_covered rule for one output. Covered means
+  // the windows cover at least kCoveredFraction of its usable area.
+  inline constexpr double kCoveredFraction = 0.9;
+  bool covered(const OutputWindows& output, ShaderPause rule);
+
+  // Publishing (provider side) and reading (consumer side).
+  void setWindowSnapshot(WindowSnapshot snapshot);
+  const WindowSnapshot& windowSnapshot();
+  // Bumps whenever a published snapshot differs from the previous one.
+  std::uint64_t windowSnapshotSerial();
+  // Called after each change; returns an id for removeWindowListener.
+  std::uint64_t addWindowListener(std::function<void()> callback);
+  void removeWindowListener(std::uint64_t id);
+  // Whether a consumer needs fresh window data; the provider polls only while true.
+  void setWindowDemand(bool wanted);
+  bool windowDemand();
+  void setWindowDemandCallback(std::function<void(bool)> callback);
+  // False until a provider exists (another compositor): consumers then never pause.
+  void setWindowProviderAvailable(bool available);
+  bool windowProviderAvailable();
+
+} // namespace live
