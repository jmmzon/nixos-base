diff --git a/src/tools/shader_thumbnail_main.cpp b/src/tools/shader_thumbnail_main.cpp
new file mode 100644
index 000000000..230172b36
--- /dev/null
+++ b/src/tools/shader_thumbnail_main.cpp
@@ -0,0 +1,217 @@
+// noctalia-shader-thumbnail: renders "shader:" wallpapers to PNG thumbnails with
+// the wallpaper's own renderer (ShaderLiveWallpaper), headless on a surfaceless
+// EGL context, so previews match what the wallpaper shows: buffers, channel
+// images and KDE's window inputs (none) included.
+//
+//   noctalia-shader-thumbnail --out DIR [--size WxH] [--time SECONDS] [--dir SEARCHDIR]... SPEC...
+//
+// SPEC is what follows "shader:" (a name, "lib/Shaders/name" or a path). Each
+// thumbnail is written to DIR/<SPEC with characters outside [A-Za-z0-9._-]
+// replaced by '_'>.png, after rendering about SECONDS of iTime (default 1.5, so
+// fade-ins and simulations get going). One line per shader on stdout:
+// "ok <spec> <file>" or "fail <spec> <reason>". Exit status 0 unless the
+// arguments or the GL context were unusable.
+//
+// The live wallpaper's program binary cache ($XDG_CACHE_HOME/noctalia/shaders)
+// is shared, so a thumbnailed shader also loads faster as a wallpaper later.
+
+#include "app/shell_library.h"
+#include "config/config_types.h"
+#include "render/codecs/image_encoder.h"
+#include "shell/shader/shader_live_wallpaper.h"
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+  std::string fileNameFor(const std::string& spec) {
+    std::string out;
+    for (const char c : spec) {
+      const bool keep = (c >= 'a' && c <= 'z')
+          || (c >= 'A' && c <= 'Z')
+          || (c >= '0' && c <= '9')
+          || c == '.'
+          || c == '_'
+          || c == '-';
+      out.push_back(keep ? c : '_');
+    }
+    return out + ".png";
+  }
+
+  bool makeContext() {
+    auto getPlatformDisplay =
+        reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(eglGetProcAddress("eglGetPlatformDisplayEXT"));
+    auto queryDevices = reinterpret_cast<PFNEGLQUERYDEVICESEXTPROC>(eglGetProcAddress("eglQueryDevicesEXT"));
+    EGLDisplay display = EGL_NO_DISPLAY;
+    if (getPlatformDisplay != nullptr && queryDevices != nullptr) {
+      EGLDeviceEXT devices[8];
+      EGLint count = 0;
+      if (queryDevices(8, devices, &count) == EGL_TRUE && count > 0) {
+        display = getPlatformDisplay(EGL_PLATFORM_DEVICE_EXT, devices[0], nullptr);
+      }
+    }
+    if (display == EGL_NO_DISPLAY) {
+      display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    }
+    if (display == EGL_NO_DISPLAY || eglInitialize(display, nullptr, nullptr) != EGL_TRUE) {
+      return false;
+    }
+    eglBindAPI(EGL_OPENGL_ES_API);
+    const EGLint attributes[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_NONE};
+    const EGLContext context = eglCreateContext(display, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, attributes);
+    return context != EGL_NO_CONTEXT && eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context) == EGL_TRUE;
+  }
+
+  // Top-row-first RGBA of a texture (live wallpaper textures store the top row first).
+  bool readTexture(GLuint texture, int width, int height, std::vector<std::uint8_t>& rgba) {
+    GLuint fbo = 0;
+    glGenFramebuffers(1, &fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0);
+    const bool ok = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    if (ok) {
+      rgba.resize(static_cast<std::size_t>(width) * static_cast<std::size_t>(height) * 4);
+      glPixelStorei(GL_PACK_ALIGNMENT, 1);
+      glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDeleteFramebuffers(1, &fbo);
+    return ok && glGetError() == GL_NO_ERROR;
+  }
+
+  bool writeFile(const std::filesystem::path& file, const std::vector<std::uint8_t>& bytes) {
+    const auto tmp = std::filesystem::path(file.string() + ".tmp");
+    {
+      std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+      out.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+      if (!out) {
+        return false;
+      }
+    }
+    std::error_code ec;
+    std::filesystem::rename(tmp, file, ec);
+    return !ec;
+  }
+
+  int usage() {
+    std::fprintf(
+        stderr,
+        "usage: noctalia-shader-thumbnail --out DIR [--size WxH] [--time SECONDS] [--dir SEARCHDIR]... SPEC...\n"
+    );
+    return 2;
+  }
+
+} // namespace
+
+int main(int argc, char** argv) {
+  std::filesystem::path outDir;
+  int width = 320;
+  int height = 180;
+  double seconds = 1.5;
+  std::vector<std::string> directories;
+  std::vector<std::string> specs;
+  for (int i = 1; i < argc; ++i) {
+    const std::string arg = argv[i];
+    const bool hasValue = i + 1 < argc;
+    if (arg == "--out" && hasValue) {
+      outDir = argv[++i];
+    } else if (arg == "--size" && hasValue) {
+      if (std::sscanf(argv[++i], "%dx%d", &width, &height) != 2 || width <= 0 || height <= 0) {
+        return usage();
+      }
+    } else if (arg == "--time" && hasValue) {
+      seconds = std::atof(argv[++i]);
+    } else if (arg == "--dir" && hasValue) {
+      directories.emplace_back(argv[++i]);
+    } else if (arg.starts_with("--")) {
+      return usage();
+    } else {
+      specs.push_back(arg);
+    }
+  }
+  if (outDir.empty() || specs.empty()) {
+    return usage();
+  }
+  std::error_code ec;
+  std::filesystem::create_directories(outDir, ec);
+
+  // Still frames the renderer captures go to a throwaway state dir, not the shell's.
+  char pattern[] = "/tmp/noctalia-shader-thumbnail.XXXXXX";
+  const char* stateDir = ::mkdtemp(pattern);
+  if (stateDir == nullptr) {
+    return 1;
+  }
+  ::setenv("XDG_STATE_HOME", stateDir, 1);
+  configureSharedLibrary();
+  if (!makeContext()) {
+    std::fprintf(stderr, "noctalia-shader-thumbnail: no surfaceless OpenGL ES 3 context\n");
+    std::filesystem::remove_all(stateDir, ec);
+    return 1;
+  }
+
+  WallpaperConfig config;
+  config.shader.renderScale = 1.0F;
+  config.shader.desktopMotion = ShaderMotion::Animated;
+  config.shader.directories = directories;
+  auto& renderer = ShaderLiveWallpaper::instance();
+  renderer.setConfig(config);
+
+  using Clock = std::chrono::steady_clock;
+  for (std::size_t index = 0; index < specs.size(); ++index) {
+    const std::string& spec = specs[index];
+    const std::string path = "shader:" + spec;
+    const void* consumer = &specs[index];
+    const LiveFrameRequest request{.consumer = consumer, .path = path, .width = width, .height = height};
+    const auto started = Clock::now();
+    std::optional<Clock::time_point> readySince;
+    TextureHandle frame;
+    bool done = false;
+    while (Clock::now() - started < std::chrono::seconds(90)) {
+      renderer.advance();
+      frame = renderer.frameTexture(request);
+      if (frame.valid() && !readySince.has_value()) {
+        readySince = Clock::now();
+      }
+      if (readySince.has_value() && std::chrono::duration<double>(Clock::now() - *readySince).count() >= seconds) {
+        done = true;
+        break;
+      }
+      if (renderer.status(path) == ShaderLiveWallpaper::Status::Failed) {
+        break; // missing or does not compile (the reason is in the log)
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(16));
+    }
+    if (!done) {
+      std::printf("fail %s %s\n", spec.c_str(), readySince.has_value() ? "timeout" : "not found or does not compile");
+      std::fflush(stdout);
+      renderer.forgetConsumer(consumer);
+      continue;
+    }
+    std::vector<std::uint8_t> rgba;
+    std::string error;
+    const auto file = outDir / fileNameFor(spec);
+    const bool ok = readTexture(frame.id.value(), frame.width, frame.height, rgba)
+        && writeFile(file, encodePng(rgba.data(), frame.width, frame.height, &error));
+    if (ok) {
+      std::printf("ok %s %s\n", spec.c_str(), file.string().c_str());
+    } else {
+      std::printf("fail %s %s\n", spec.c_str(), error.empty() ? "readback or write failed" : error.c_str());
+    }
+    std::fflush(stdout);
+    renderer.forgetConsumer(consumer);
+  }
+  std::filesystem::remove_all(stateDir, ec);
+  // The renderer is a leaked singleton holding GL names; exit without tearing the context down under it.
+  std::_Exit(0);
+}
-- 
