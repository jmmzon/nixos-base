diff --git a/src/render/programs/glass_params.cpp b/src/render/programs/glass_params.cpp
new file mode 100644
index 0000000..17bd058
--- /dev/null
+++ b/src/render/programs/glass_params.cpp
@@ -0,0 +1,35 @@
+#include "render/programs/glass_params.h"
+
+#include <cstdio>
+#include <utility>
+
+namespace glass_params {
+
+  namespace {
+    Values g_current;
+    std::uint64_t g_generation = 0;
+  } // namespace
+
+  void set(Values values) {
+    if (values == g_current) {
+      return;
+    }
+    g_current = std::move(values);
+    ++g_generation;
+  }
+
+  const Values& current() { return g_current; }
+
+  std::uint64_t generation() { return g_generation; }
+
+  std::string glslFloat(double value) {
+    char buf[64];
+    std::snprintf(buf, sizeof(buf), "%.9g", value);
+    std::string out(buf);
+    if (out.find_first_of(".eEn") == std::string::npos) {
+      out += ".0";
+    }
+    return out;
+  }
+
+} // namespace glass_params
