+      continue;
+    }
+    const auto slot = static_cast<std::size_t>(from.slot);
+    std::string wanted = directives.textures[slot];
+    if (const auto it = m_config.textures.find(shader::textureOverrideKey(program.spec, from.slot));
+        it != m_config.textures.end()) {
+      wanted = it->second;
+    }
+    if (wanted.empty()) {
+      continue;
+    }
+    const auto file = shader::resolveTexturePath(wanted, program.file);
+    if (!file.has_value()) {
+      kLog.warn("{}: image '{}' for iChannel{} not found", program.spec, wanted, c);
+      continue;
