+    TEST_CHECK(contains(out, "uniform float iTime;"));
+    TEST_CHECK(contains(out, "uniform sampler2D iChannel3;"));
+    TEST_CHECK(contains(out, "uniform vec2 iScreenOffset;"));
+    TEST_CHECK(contains(out, "#line 1\n"));
