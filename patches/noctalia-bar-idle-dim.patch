+bool Bar::idleDimAwake(const BarInstance& instance) const {
+  if (instance.pointerInside || instance.attachedPopupCount > 0) {
+    return true;
+  }
+  return m_autoHideSuppressionCallback != nullptr && m_autoHideSuppressionCallback(instance);
+}
+
+void Bar::applyIdleDimOpacity(BarInstance& instance) const {
+  if (instance.slideRoot == nullptr) {
+    return;
+  }
+  instance.slideRoot->setOpacity(instance.barConfig.isIdleDimEnabled() ? instance.idleDim : 1.0F);
+}
+
+void Bar::animateIdleDim(BarInstance& instance, float target) {
+  instance.animations.cancelForOwner(&instance.idleDim);
+  if (std::abs(instance.idleDim - target) < 0.001F) {
+    instance.idleDim = target;
+    applyIdleDimOpacity(instance);
+    return;
+  }
+  const bool waking = target > instance.idleDim;
+  // animateTimer: the fade runs on its own clock, so it still finishes with reduced motion.
+  instance.animations.animateTimer(
+      instance.idleDim, target, waking ? kIdleDimWakeMs : kIdleDimFadeMs,
+      waking ? Easing::EaseOutCubic : Easing::EaseInOutQuad,
+      [this, inst = &instance](float v) {
+        inst->idleDim = v;
+        applyIdleDimOpacity(*inst);
+      },
+      {}, &instance.idleDim
+  );
+  if (instance.surface != nullptr) {
+    instance.surface->requestRedraw();
+  }
+}
+
+void Bar::wakeIdleDim(BarInstance& instance) {
+  if (!instance.barConfig.isIdleDimEnabled()) {
+    return;
+  }
+  animateIdleDim(instance, 1.0F);
+  scheduleIdleDim(instance);
+}
+
+void Bar::scheduleIdleDim(BarInstance& instance) {
+  instance.idleDimTimer.stop();
+  if (!instance.barConfig.isIdleDimEnabled()) {
+    instance.animations.cancelForOwner(&instance.idleDim);
+    instance.idleDim = 1.0F;
+    applyIdleDimOpacity(instance);
+    return;
+  }
+  const auto delay = std::chrono::milliseconds(std::max(instance.barConfig.idleDelayMs, 0));
+  instance.idleDimTimer.start(delay, [this, inst = &instance] {
+    // Still in use (hovered, a bar popup or its attached panel open): check again later. This also
+    // catches panels closing without a bar callback.
+    if (idleDimAwake(*inst)) {
+      scheduleIdleDim(*inst);
+      return;
+    }
+    animateIdleDim(*inst, std::clamp(inst->barConfig.idleOpacity, 0.0F, 1.0F));
+  });
+}
+
+void Bar::ensurePixelShiftTimer() {
+  const bool wanted = std::ranges::any_of(m_instances, [](const auto& inst) {
+    return inst != nullptr && inst->barConfig.pixelShift > 0;
+  });
+  if (!wanted || m_pixelShiftTimer.active()) {
+    return;
+  }
+  m_pixelShiftTimer.startRepeating(kPixelShiftInterval, [this] {
+    ++m_pixelShiftStep;
+    bool any = false;
+    for (const auto& instUp : m_instances) {
+      if (instUp == nullptr) {
+        continue;
+      }
+      auto& inst = *instUp;
+      const auto [dx, dy] = pixelShiftOffset(inst.barConfig, m_pixelShiftStep);
+      any = any || inst.barConfig.pixelShift > 0;
+      if (dx == inst.pixelShiftDx && dy == inst.pixelShiftDy) {
+        continue;
+      }
+      const float ddx = dx - inst.pixelShiftDx;
+      const float ddy = dy - inst.pixelShiftDy;
+      inst.pixelShiftDx = dx;
+      inst.pixelShiftDy = dy;
+      // Content and the hover-pill underlay move together, so pills stay on their widgets.
+      if (inst.contentClip != nullptr) {
+        inst.contentClip->setPosition(inst.contentClip->x() + ddx, inst.contentClip->y() + ddy);
+      }
+      if (inst.hoverUnderlay != nullptr) {
+        inst.hoverUnderlay->setPosition(dx, dy);
+      }
+      if (inst.surface != nullptr) {
+        inst.surface->requestLayout();
+      }
+    }
+    if (!any) {
+      m_pixelShiftTimer.stop();
+    }
+  });
+}
