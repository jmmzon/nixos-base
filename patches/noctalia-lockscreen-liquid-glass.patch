diff --git a/src/shell/render/glass_params.cpp b/src/shell/render/glass_params.cpp
new file mode 100644
index 000000000..d8a928a5f
--- /dev/null
+++ b/src/shell/render/glass_params.cpp
@@ -0,0 +1,149 @@
+#include "shell/render/glass_params.h"
+
+#include "config/toml.h"
+#include "core/log.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <optional>
+#include <regex>
+#include <sstream>
+#include <utility>
+
+namespace glass_params {
+
+  namespace {
+
+    constexpr Logger kLog("glass");
+    constexpr const char* kPreset = "glass-window";
+
+    std::filesystem::path xdgDir(const char* variable, const char* fallback) {
+      const char* value = std::getenv(variable);
+      if (value != nullptr && value[0] == '/') {
+        return value;
+      }
+      const char* home = std::getenv("HOME");
+      return home != nullptr ? std::filesystem::path(home) / fallback : std::filesystem::path{};
+    }
+
+    std::optional<toml::table> parseIfPresent(const std::filesystem::path& path) {
+      std::error_code ec;
+      if (path.empty() || !std::filesystem::is_regular_file(path, ec)) {
+        return std::nullopt;
+      }
+      try {
+        return toml::parse_file(path.string());
+      } catch (const toml::parse_error& err) {
+        kLog.warn("{}: {}", path.string(), err.description());
+        return std::nullopt;
+      }
+    }
+
+    // Numbers of a params table (integers too: the tuner writes 4.0, people write 4).
+    void mergeNumbers(Values& into, const toml::table* table) {
+      if (table == nullptr) {
+        return;
+      }
+      for (const auto& [key, node] : *table) {
+        std::optional<double> value = node.value<double>();
+        if (value.has_value() && std::isfinite(*value)) {
+          into[std::string(key.str())] = *value;
+        }
+      }
+    }
+
+    // `#define NAME 1.5` lines of an Umbriel effect shader (its #ifndef defaults).
+    void mergeShaderDefaults(Values& into, const std::filesystem::path& shader) {
+      std::ifstream in(shader);
+      if (!in) {
+        kLog.warn("glass shader '{}' not readable; using built-in defaults", shader.string());
+        return;
+      }
+      static const std::regex define(R"(^\s*#define\s+([A-Z][A-Z0-9_]*)\s+(-?[0-9]*\.?[0-9]+(?:[eE][-+]?[0-9]+)?)\b)");
+      std::string line;
+      while (std::getline(in, line)) {
+        std::smatch m;
+        if (std::regex_search(line, m, define)) {
+          into[m[1].str()] = std::strtod(m[2].str().c_str(), nullptr);
+        }
+      }
+    }
+
+    const toml::table* paramsTable(const toml::table& root, std::string_view preset) {
+      return root["effects"]["params"][preset].as_table();
+    }
+
+    Values g_current;
+    std::uint64_t g_generation = 0;
+    std::optional<Values> g_staged;
+
+  } // namespace
+
+  Values loadWindowGlass() {
+    Values values;
+    const std::filesystem::path config = xdgDir("XDG_CONFIG_HOME", ".config") / "umbriel" / "glass.toml";
+    const std::optional<toml::table> glass = parseIfPresent(config);
+    if (!glass.has_value()) {
+      return values;
+    }
+    const toml::table* preset = (*glass)["effects"]["preset"][kPreset].as_table();
+    if (preset == nullptr) {
+      kLog.warn("{}: no [effects.preset.{}]", config.string(), kPreset);
+      return values;
+    }
+    if (const auto shader = (*preset)["shader"].value<std::string>()) {
+      std::filesystem::path path(*shader);
+      if (path.is_relative()) {
+        path = config.parent_path() / path;
+      }
+      mergeShaderDefaults(values, path);
+    }
+    mergeNumbers(values, (*preset)["params"].as_table());
+    mergeNumbers(values, paramsTable(*glass, kPreset));
+
+    const std::filesystem::path drafts = xdgDir("XDG_STATE_HOME", ".local/state") / "glass-tuner" / "umbriel.toml";
+    if (const std::optional<toml::table> draft = parseIfPresent(drafts)) {
+      mergeNumbers(values, paramsTable(*draft, kPreset));
+    }
+    return values;
+  }
+
+  void set(Values values) {
+    if (values == g_current) {
+      return;
+    }
+    g_current = std::move(values);
+    ++g_generation;
+  }
+
+  const Values& current() { return g_current; }
+
+  std::uint64_t generation() { return g_generation; }
+
+  bool reloadWindowGlass() {
+    const std::uint64_t before = g_generation;
+    set(loadWindowGlass());
+    if (g_generation != before) {
+      kLog.info("lock glass: {} values from Umbriel's {}", g_current.size(), kPreset);
+    }
+    return g_generation != before;
+  }
+
+  void markStaged(const Values& values) { g_staged = values; }
+
+  bool greeterOutOfDate() { return !g_staged.has_value() || *g_staged != g_current; }
+
+  std::string glslFloat(double value) {
+    char buf[64];
+    std::snprintf(buf, sizeof(buf), "%.9g", value);
+    std::string out(buf);
+    if (out.find_first_of(".eEn") == std::string::npos) {
+      out += ".0";
+    }
+    return out;
+  }
+
+} // namespace glass_params
diff --git a/src/shell/render/glass_params.h b/src/shell/render/glass_params.h
new file mode 100644
index 000000000..981486e23
--- /dev/null
+++ b/src/shell/render/glass_params.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <string>
+
+// The liquid glass knobs (REFRACTION, WAVE_AMP, ...) of the lock screen glass, taken from
+// Umbriel's window glass so the lock looks like the windows: the defaults written in the
+// glass-window shader, then the preset's params in glass.toml, then [effects.params] there
+// and in the glass tuner's unsaved drafts. Empty when Umbriel's glass is not set up.
+namespace glass_params {
+
+  using Values = std::map<std::string, double>;
+
+  // Reads the files now. Missing or broken files give fewer (or no) values.
+  [[nodiscard]] Values loadWindowGlass();
+
+  // The values the glass shader is built with; generation() changes whenever they do.
+  void set(Values values);
+  [[nodiscard]] const Values& current();
+  [[nodiscard]] std::uint64_t generation();
+
+  // Loads the window glass and installs it; true when the values changed.
+  bool reloadWindowGlass();
+
+  // The greeter shows the window glass staged by the shell's greeter sync ([appearance.glass]).
+  // markStaged records what the last sync staged; greeterOutOfDate is true when the lock's
+  // values differ from that (or nothing was staged since the shell started).
+  void markStaged(const Values& values);
+  [[nodiscard]] bool greeterOutOfDate();
+
+  // A GLSL float literal ("93.0", "-0.25", "1e-05").
+  [[nodiscard]] std::string glslFloat(double value);
+
+} // namespace glass_params
