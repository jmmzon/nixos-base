# Hyprland: a second compositor session beside Umbriel (SYS-116). The greeter
# offers "Hyprland (uwsm-managed)"; Umbriel stays the default session.
#
# Hyprland comes from the pinned nixpkgs (binary-cached; UWSM's variant is the
# cached one). Its plugins are built here against that exact package with
# nixpkgs' mkHyprlandPlugin (hyprpm is unsupported on Nix):
#   - HyprGlass: liquid glass under windows (and later layer surfaces).
#   - ScrollOverview: niri-style overview of the scrolling workspaces.
# Bump both inputs together with Hyprland (HyprGlass: its hyprland-X.Y branch).
#
# The config is Lua (0.57 dropped hyprland.conf): home/hyprland/hyprland.lua,
# linked live like Umbriel's, so a saved edit applies without a rebuild. The
# plugin store paths live in a generated ~/.config/hypr/plugins.lua it requires.
{ inputs, ... }:
let
  mkPlugins =
    pkgs: hyprland:
    let
      mk = pkgs.hyprlandPlugins.mkHyprlandPlugin;
    in
    {
      hyprglass = mk {
        pluginName = "hyprglass";
        version = "1.1.1-unstable-2026-11-03";
        src = inputs.hyprglass;
        inherit hyprland;
        nativeBuildInputs = [ pkgs.wayland-scanner ];
        dontUseCmakeConfigure = true;
        enableParallelBuilding = true;
        makeFlags = [ "HYPRGLASS_VERSION=1.1.1-nix" ];
        installPhase = ''
          runHook preInstall
          install -Dm755 hyprglass.so $out/lib/libhyprglass.so
          runHook postInstall
        '';
        meta = {
          homepage = "https://github.com/hyprnux/hyprglass";
          description = "Liquid glass effect for Hyprland";
          license = pkgs.lib.licenses.bsd3;
        };
      };
      scrolloverview = mk {
        pluginName = "scrolloverview";
        version = "0-unstable-2026-11-05";
        src = inputs.scrolloverview;
        inherit hyprland;
        buildInputs = [ pkgs.lua5_4 ];
        dontUseCmakeConfigure = true;
        dontUseMesonConfigure = true;
        env.SCROLLOVERVIEW_BUILD_VERSION = "3eb62e3e0093";
        installPhase = ''
          runHook preInstall
          install -Dm755 scrolloverview.so $out/lib/libscrolloverview.so
          runHook postInstall
        '';
        meta = {
          homepage = "https://github.com/yayuuu/hyprland-scroll-overview";
          description = "Scrollable workspace overview plugin for Hyprland";
          license = pkgs.lib.licenses.bsd3;
        };
      };
    };
in
{
  flake.modules.nixos.hyprland =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    lib.mkIf config.my.hyprland.enable {
      programs.hyprland = {
        enable = true;
        # UWSM starts graphical-session.target (Noctalia, xremap, edge swipes)
        # and imports the session environment, as start-umbriel does.
        withUWSM = true;
      };
      # The plugins, for `hyprctl plugin load` by hand and for the HM side.
      environment.systemPackages = lib.attrValues (mkPlugins pkgs config.programs.hyprland.package);
    };

  flake.modules.homeManager.hyprland =
    {
      config,
      osConfig,
      lib,
      pkgs,
      ...
    }:
    let
      plugins = mkPlugins pkgs osConfig.programs.hyprland.package;
      liveFile = import ./_live-file.nix { inherit config osConfig; };
    in
    lib.mkIf osConfig.my.hyprland.enable {
      # Live: a link into the checkout (my.flakePath); Hyprland follows the
      # symlink and reloads on save.
      xdg.configFile."hypr/hyprland.lua".source = liveFile "home/hyprland/hyprland.lua";
      # xremap's focus-or-launch (home/xremap/focus-or-launch) under Hyprland.
      home.file.".local/bin/hypr-focus-or-launch" = {
        source = ../home/hyprland/focus-or-launch;
        executable = true;
      };
      # Generated: the plugins built against the running Hyprland.
      xdg.configFile."hypr/plugins.lua".text = ''
        -- Generated by modules/hyprland.nix; do not edit.
        return {
          hyprglass = "${plugins.hyprglass}/lib/libhyprglass.so",
          scrolloverview = "${plugins.scrolloverview}/lib/libscrolloverview.so",
        }
      '';
    };
}
