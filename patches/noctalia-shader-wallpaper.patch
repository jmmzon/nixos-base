diff --git a/src/shell/live/window_geometry.cpp b/src/shell/live/window_geometry.cpp
new file mode 100644
index 000000000..53fbee974
--- /dev/null
+++ b/src/shell/live/window_geometry.cpp
@@ -0,0 +1,154 @@
+#include "shell/live/window_geometry.h"
+
+#include "config/config_types.h"
+
+#include <algorithm>
+#include <map>
+#include <utility>
+
+namespace live {
+
+  namespace {
+
+    struct State {
+      WindowSnapshot snapshot;
+      std::uint64_t serial = 0;
+      std::map<std::uint64_t, std::function<void()>> listeners;
+      std::uint64_t nextListener = 1;
+      bool demand = false;
+      std::function<void(bool)> demandCallback;
+      bool providerAvailable = false;
+    };
+
+    // Leaked: consumers may unregister during static destruction.
+    State& state() {
+      static auto* s = new State();
+      return *s;
+    }
+
+  } // namespace
+
+  double coverage(const OutputWindows& output) {
+    if (output.width <= 0 || output.height <= 0) {
+      return 0.0;
+    }
+    // The area windows can occupy: the usable box, clipped to the output.
+    WindowBox area{0, 0, output.width, output.height};
+    if (output.usable.width > 0 && output.usable.height > 0) {
+      const int x0 = std::clamp(output.usable.x, 0, output.width);
+      const int y0 = std::clamp(output.usable.y, 0, output.height);
+      const int x1 = std::clamp(output.usable.x + output.usable.width, 0, output.width);
+      const int y1 = std::clamp(output.usable.y + output.usable.height, 0, output.height);
+      if (x1 > x0 && y1 > y0) {
+        area = {x0, y0, x1 - x0, y1 - y0};
+      }
+    }
+    // Exact union area by coordinate compression: few windows, so O(n^3) is fine.
+    std::vector<int> xs = {area.x, area.x + area.width};
+    std::vector<int> ys = {area.y, area.y + area.height};
+    std::vector<WindowBox> boxes;
+    for (const WindowBox& w : output.windows) {
+      const int x0 = std::clamp(w.x, area.x, area.x + area.width);
+      const int y0 = std::clamp(w.y, area.y, area.y + area.height);
+      const int x1 = std::clamp(w.x + w.width, area.x, area.x + area.width);
+      const int y1 = std::clamp(w.y + w.height, area.y, area.y + area.height);
+      if (x1 <= x0 || y1 <= y0) {
+        continue;
+      }
+      boxes.push_back({x0, y0, x1 - x0, y1 - y0});
+      xs.push_back(x0);
+      xs.push_back(x1);
+      ys.push_back(y0);
+      ys.push_back(y1);
+    }
+    std::ranges::sort(xs);
+    xs.erase(std::unique(xs.begin(), xs.end()), xs.end());
+    std::ranges::sort(ys);
+    ys.erase(std::unique(ys.begin(), ys.end()), ys.end());
+    double covered = 0.0;
+    for (std::size_t i = 0; i + 1 < xs.size(); ++i) {
+      for (std::size_t j = 0; j + 1 < ys.size(); ++j) {
+        const int cx = xs[i];
+        const int cy = ys[j];
+        const bool inside = std::ranges::any_of(boxes, [cx, cy](const WindowBox& b) {
+          return cx >= b.x && cx < b.x + b.width && cy >= b.y && cy < b.y + b.height;
+        });
+        if (inside) {
+          covered += static_cast<double>(xs[i + 1] - xs[i]) * static_cast<double>(ys[j + 1] - ys[j]);
+        }
+      }
+    }
+    return covered / (static_cast<double>(area.width) * static_cast<double>(area.height));
+  }
+
+  bool covered(const OutputWindows& output, ShaderPause rule) {
+    switch (rule) {
+    case ShaderPause::Off:
+      return false;
+    case ShaderPause::Fullscreen:
+      return output.fullscreen;
+    case ShaderPause::Maximized:
+      return output.fullscreen || output.maximized;
+    case ShaderPause::Covered:
+      return output.fullscreen || output.maximized || coverage(output) >= kCoveredFraction;
+    }
+    return false;
+  }
+
+  void setWindowSnapshot(WindowSnapshot snapshot) {
+    State& s = state();
+    if (snapshot == s.snapshot) {
+      return;
+    }
+    s.snapshot = std::move(snapshot);
+    ++s.serial;
+    // Copy: a listener may add or remove listeners.
+    std::vector<std::function<void()>> listeners;
+    listeners.reserve(s.listeners.size());
+    for (const auto& [id, fn] : s.listeners) {
+      listeners.push_back(fn);
+    }
+    for (auto& fn : listeners) {
+      fn();
+    }
+  }
+
+  const WindowSnapshot& windowSnapshot() { return state().snapshot; }
+
+  std::uint64_t windowSnapshotSerial() { return state().serial; }
+
+  std::uint64_t addWindowListener(std::function<void()> callback) {
+    State& s = state();
+    const std::uint64_t id = s.nextListener++;
+    s.listeners.emplace(id, std::move(callback));
+    return id;
+  }
+
+  void removeWindowListener(std::uint64_t id) { state().listeners.erase(id); }
+
+  void setWindowDemand(bool wanted) {
+    State& s = state();
+    if (wanted == s.demand) {
+      return;
+    }
+    s.demand = wanted;
+    if (s.demandCallback) {
+      s.demandCallback(wanted);
+    }
+  }
+
+  bool windowDemand() { return state().demand; }
+
+  void setWindowDemandCallback(std::function<void(bool)> callback) {
+    State& s = state();
+    s.demandCallback = std::move(callback);
+    if (s.demandCallback && s.demand) {
+      s.demandCallback(true);
+    }
+  }
+
+  void setWindowProviderAvailable(bool available) { state().providerAvailable = available; }
+
+  bool windowProviderAvailable() { return state().providerAvailable; }
+
+} // namespace live
