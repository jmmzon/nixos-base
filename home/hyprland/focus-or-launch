#!/usr/bin/env bash
# Hyprland twin of umbriel-focus-or-launch (SYS-116): focus the first window
# whose class is one of APP_IDs, or launch COMMAND and focus its window.
set -euo pipefail

if (( $# < 2 )); then
  echo "usage: hypr-focus-or-launch APP_ID[|APP_ID...] COMMAND [ARG...]" >&2
  exit 2
fi

app_ids=$1
shift

lock_key=${app_ids//[^[:alnum:]._-]/_}
lock_file="${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr-focus-or-launch-$lock_key.lock"
exec 9>"$lock_file"
flock -n 9 || exit 0

find_window() {
  hyprctl clients -j | jq -er --arg ids "$app_ids" '
    ($ids | split("|") | map(ascii_downcase)) as $wanted
    | [.[] | select((.class // "" | ascii_downcase) as $app | $wanted | index($app))]
    | if length == 0 then empty else first.address end
  '
}

focus_window() {
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null
}

if address=$(find_window); then
  focus_window "$address"
  exit 0
fi

"$@" 9>&- >/dev/null 2>&1 &

for _ in {1..40}; do
  sleep 0.05
  if address=$(find_window); then
    focus_window "$address"
    exit 0
  fi
done
