diff --git a/tests/window_geometry_test.cpp b/tests/window_geometry_test.cpp
new file mode 100644
index 000000000..8026cbbe4
--- /dev/null
+++ b/tests/window_geometry_test.cpp
@@ -0,0 +1,117 @@
+#include "compositors/umbriel/umbriel_window_tracker.h"
+#include "config/config_types.h"
+#include "shell/live/window_geometry.h"
+#include "tests/test_check.h"
+
+#include <cmath>
+#include <nlohmann/json.hpp>
+
+namespace {
+
+  live::OutputWindows output(std::vector<live::WindowBox> windows, bool fullscreen = false, bool maximized = false) {
+    return live::OutputWindows{
+        .width = 1000, .height = 500, .fullscreen = fullscreen, .maximized = maximized, .windows = std::move(windows)
+    };
+  }
+
+  bool near(double a, double b) { return std::abs(a - b) < 1e-9; }
+
+  void testCoverage() {
+    TEST_CHECK(near(live::coverage(output({})), 0.0));
+    TEST_CHECK(near(live::coverage(output({{0, 0, 1000, 500}})), 1.0));
+    TEST_CHECK(near(live::coverage(output({{0, 0, 500, 500}})), 0.5));
+    // Overlaps count once; parts off the output do not count.
+    TEST_CHECK(near(live::coverage(output({{0, 0, 600, 500}, {400, 0, 600, 500}})), 1.0));
+    TEST_CHECK(near(live::coverage(output({{-500, 0, 1000, 500}})), 0.5));
+    TEST_CHECK(near(live::coverage(output({{1000, 0, 400, 500}})), 0.0));
+    // Two tiled columns with 10 px gaps around them.
+    const auto tiled = output({{10, 10, 485, 480}, {505, 10, 485, 480}});
+    TEST_CHECK(live::coverage(tiled) > 0.9 && live::coverage(tiled) < 0.95);
+    TEST_CHECK(near(live::coverage(live::OutputWindows{}), 0.0));
+    // Measured against the usable area: a 50 px bar does not keep tiled windows from covering it.
+    auto withBar = output({{10, 10, 485, 430}, {505, 10, 485, 430}});
+    TEST_CHECK(live::coverage(withBar) < 0.9);
+    withBar.usable = {0, 0, 1000, 450};
+    TEST_CHECK(live::coverage(withBar) > 0.9);
+  }
+
+  void testRules() {
+    const auto half = output({{0, 0, 500, 500}});
+    const auto tiled = output({{10, 10, 485, 480}, {505, 10, 485, 480}});
+    const auto fullscreen = output({{0, 0, 1000, 500}}, true);
+    const auto maximized = output({{0, 0, 1000, 500}}, false, true);
+    for (const auto* o : {&half, &tiled, &fullscreen, &maximized}) {
+      TEST_CHECK(!live::covered(*o, ShaderPause::Off));
+    }
+    TEST_CHECK(live::covered(fullscreen, ShaderPause::Fullscreen));
+    TEST_CHECK(!live::covered(maximized, ShaderPause::Fullscreen));
+    TEST_CHECK(live::covered(maximized, ShaderPause::Maximized));
+    TEST_CHECK(!live::covered(tiled, ShaderPause::Maximized));
+    TEST_CHECK(live::covered(tiled, ShaderPause::Covered));
+    TEST_CHECK(!live::covered(half, ShaderPause::Covered));
+  }
+
+  void testUmbrielParse() {
+    // Shapes as Umbriel's IPC sends them (trimmed): slots are global layout coordinates.
+    const auto outputs = nlohmann::json::parse(R"([
+      {"name": "HEADLESS-2", "enabled": true, "logical_size": {"width": 1280, "height": 720}, "position": {"x": 0, "y": 0}},
+      {"name": "HEADLESS-1", "enabled": true, "logical_size": {"width": 1280, "height": 720}, "position": {"x": 1280, "y": 0}, "usable_area": {"x": 1280, "y": 0, "width": 1280, "height": 664}},
+      {"name": "OFF-1", "enabled": false, "logical_size": {"width": 800, "height": 600}, "position": {"x": 2560, "y": 0}}
+    ])");
+    const auto windows = nlohmann::json::parse(R"([
+      {"output": "HEADLESS-1", "visible": true, "minimized": false, "fullscreen": false, "maximized": false, "x": 1570, "y": 10, "w": 700, "h": 700},
+      {"output": "HEADLESS-2", "visible": true, "minimized": false, "fullscreen": true, "maximized": false, "x": 0, "y": 0, "w": 1280, "h": 720},
+      {"output": "HEADLESS-1", "visible": false, "minimized": false, "fullscreen": true, "maximized": false, "x": 1290, "y": 10, "w": 700, "h": 700},
+      {"output": "HEADLESS-1", "visible": true, "minimized": true, "maximized": true, "x": 1290, "y": 10, "w": 700, "h": 700},
+      {"output": "HEADLESS-1", "visible": true, "maximized_to_edges": true, "x": 2700, "y": 0, "w": 0, "h": 0},
+      {"output": "OFF-1", "visible": true, "x": 2600, "y": 0, "w": 100, "h": 100}
+    ])");
+    const auto snapshot = compositors::umbriel::parseWindowSnapshot(windows, outputs);
+    TEST_CHECK(snapshot.size() == 2); // the disabled output is left out
+    const auto& one = snapshot.at("HEADLESS-1");
+    TEST_CHECK(one.width == 1280 && one.height == 720);
+    TEST_CHECK(one.usable == (live::WindowBox{0, 0, 1280, 664}));
+    TEST_CHECK(one.windows.size() == 1); // hidden, minimized and empty windows do not count as boxes
+    TEST_CHECK(one.windows[0] == (live::WindowBox{290, 10, 700, 700}));
+    TEST_CHECK(!one.fullscreen); // the fullscreen window is on a hidden workspace
+    TEST_CHECK(one.maximized);   // maximized_to_edges counts, a minimized maximized window does not
+    const auto& two = snapshot.at("HEADLESS-2");
+    TEST_CHECK(two.fullscreen);
+    TEST_CHECK(two.windows.size() == 1 && two.windows[0] == (live::WindowBox{0, 0, 1280, 720}));
+    TEST_CHECK(
+        compositors::umbriel::parseWindowSnapshot(nlohmann::json::object(), outputs).at("HEADLESS-1").windows.empty()
+    );
+  }
+
+  void testPublish() {
+    int calls = 0;
+    const auto id = live::addWindowListener([&calls] { ++calls; });
+    const auto serial = live::windowSnapshotSerial();
+    live::WindowSnapshot snapshot;
+    snapshot["DP-1"] = output({{0, 0, 10, 10}});
+    live::setWindowSnapshot(snapshot);
+    live::setWindowSnapshot(snapshot); // unchanged: no notification
+    TEST_CHECK(calls == 1);
+    TEST_CHECK(live::windowSnapshotSerial() == serial + 1);
+    live::removeWindowListener(id);
+    live::setWindowSnapshot({});
+    TEST_CHECK(calls == 1);
+
+    bool polled = false;
+    live::setWindowDemandCallback([&polled](bool wanted) { polled = wanted; });
+    live::setWindowDemand(true);
+    TEST_CHECK(polled && live::windowDemand());
+    live::setWindowDemand(false);
+    TEST_CHECK(!polled);
+    live::setWindowDemandCallback({});
+  }
+
+} // namespace
+
+int main() {
+  testCoverage();
+  testRules();
+  testUmbrielParse();
+  testPublish();
+  return 0;
+}
