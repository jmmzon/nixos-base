diff --git a/src/compositors/umbriel/umbriel_window_tracker.cpp b/src/compositors/umbriel/umbriel_window_tracker.cpp
new file mode 100644
index 000000000..22ae66884
--- /dev/null
+++ b/src/compositors/umbriel/umbriel_window_tracker.cpp
@@ -0,0 +1,162 @@
+#include "compositors/umbriel/umbriel_window_tracker.h"
+
+#include "compositors/umbriel/umbriel_runtime.h"
+
+#include <chrono>
+#include <optional>
+#include <string>
+#include <unordered_map>
+#include <utility>
+
+namespace compositors::umbriel {
+
+  namespace {
+
+    constexpr auto kPollInterval = std::chrono::milliseconds(250);
+
+    int intField(const nlohmann::json& object, const char* key) {
+      const auto it = object.find(key);
+      return it != object.end() && it->is_number() ? it->get<int>() : 0;
+    }
+
+    bool boolField(const nlohmann::json& object, const char* key) {
+      const auto it = object.find(key);
+      return it != object.end() && it->is_boolean() && it->get<bool>();
+    }
+
+    std::string stringField(const nlohmann::json& object, const char* key) {
+      const auto it = object.find(key);
+      return it != object.end() && it->is_string() ? it->get<std::string>() : std::string{};
+    }
+
+    // The payload of a successful reply ({"ok": ...}); requestCommand returns the whole reply.
+    std::optional<nlohmann::json> okArray(std::optional<nlohmann::json> reply) {
+      if (!reply.has_value() || !reply->is_object()) {
+        return std::nullopt;
+      }
+      const auto it = reply->find("ok");
+      if (it == reply->end() || !it->is_array()) {
+        return std::nullopt;
+      }
+      return std::move(*it);
+    }
+
+  } // namespace
+
+  live::WindowSnapshot parseWindowSnapshot(const nlohmann::json& windows, const nlohmann::json& outputs) {
+    live::WindowSnapshot snapshot;
+    struct Origin {
+      int x = 0;
+      int y = 0;
+    };
+    std::unordered_map<std::string, Origin> origins;
+    if (outputs.is_array()) {
+      for (const auto& output : outputs) {
+        if (!output.is_object() || (output.contains("enabled") && !boolField(output, "enabled"))) {
+          continue;
+        }
+        const std::string name = stringField(output, "name");
+        if (name.empty()) {
+          continue;
+        }
+        live::OutputWindows& entry = snapshot[name];
+        if (const auto size = output.find("logical_size"); size != output.end() && size->is_object()) {
+          entry.width = intField(*size, "width");
+          entry.height = intField(*size, "height");
+        }
+        Origin origin;
+        if (const auto position = output.find("position"); position != output.end() && position->is_object()) {
+          origin = {intField(*position, "x"), intField(*position, "y")};
+        }
+        // Global layout coordinates, like the window slots.
+        if (const auto usable = output.find("usable_area"); usable != output.end() && usable->is_object()) {
+          entry.usable = live::WindowBox{
+              .x = intField(*usable, "x") - origin.x,
+              .y = intField(*usable, "y") - origin.y,
+              .width = intField(*usable, "width"),
+              .height = intField(*usable, "height"),
+          };
+        }
+        origins[name] = origin;
+      }
+    }
+    if (!windows.is_array()) {
+      return snapshot;
+    }
+    for (const auto& window : windows) {
+      if (!window.is_object() || !boolField(window, "visible") || boolField(window, "minimized")) {
+        continue;
+      }
+      const std::string name = stringField(window, "output");
+      const auto origin = origins.find(name);
+      if (origin == origins.end()) {
+        continue; // unknown or disabled output
+      }
+      live::OutputWindows& entry = snapshot[name];
+      entry.fullscreen = entry.fullscreen || boolField(window, "fullscreen");
+      entry.maximized = entry.maximized || boolField(window, "maximized") || boolField(window, "maximized_to_edges");
+      const int width = intField(window, "w");
+      const int height = intField(window, "h");
+      if (width <= 0 || height <= 0) {
+        continue;
+      }
+      entry.windows.push_back(
+          live::WindowBox{
+              .x = intField(window, "x") - origin->second.x,
+              .y = intField(window, "y") - origin->second.y,
+              .width = width,
+              .height = height,
+          }
+      );
+    }
+    return snapshot;
+  }
+
+  UmbrielWindowTracker::UmbrielWindowTracker(UmbrielRuntime& runtime) : UmbrielEventHandler(runtime) {}
+
+  UmbrielWindowTracker::~UmbrielWindowTracker() { m_pollTimer.stop(); }
+
+  void UmbrielWindowTracker::handleEvent(std::string_view event, const nlohmann::json& data) {
+    if (event == "windows" && data.is_array()) {
+      m_windows = data;
+      publish();
+    } else if (event == "outputs" && data.is_array()) {
+      m_outputs = data;
+      publish();
+    }
+  }
+
+  void UmbrielWindowTracker::handleStreamReset() {
+    m_windows = nlohmann::json::array();
+    m_outputs = nlohmann::json::array();
+    publish();
+  }
+
+  void UmbrielWindowTracker::setPolling(bool polling) {
+    if (polling == m_polling) {
+      return;
+    }
+    m_polling = polling;
+    if (!polling) {
+      m_pollTimer.stop();
+      return;
+    }
+    if (m_outputs.empty()) {
+      if (auto outputs = okArray(m_runtime.requestCommand("outputs")); outputs.has_value()) {
+        m_outputs = std::move(*outputs);
+      }
+    }
+    poll();
+    m_pollTimer.startRepeating(kPollInterval, [this] { poll(); });
+  }
+
+  void UmbrielWindowTracker::poll() {
+    if (auto windows = okArray(m_runtime.requestCommand("windows")); windows.has_value()) {
+      m_windows = std::move(*windows);
+      publish();
+    }
+  }
+
+  void UmbrielWindowTracker::publish() { live::setWindowSnapshot(parseWindowSnapshot(m_windows, m_outputs)); }
+
+} // namespace compositors::umbriel
diff --git a/src/compositors/umbriel/umbriel_window_tracker.h b/src/compositors/umbriel/umbriel_window_tracker.h
new file mode 100644
index 000000000..a8efdd2b8
--- /dev/null
+++ b/src/compositors/umbriel/umbriel_window_tracker.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include "compositors/umbriel/umbriel_event_handler.h"
+#include "core/timer_manager.h"
+#include "shell/live/window_geometry.h"
+
+#include <nlohmann/json.hpp>
+
+namespace compositors::umbriel {
+
+  // Window placement per output from Umbriel's IPC ("windows" + "outputs"),
+  // published as live::WindowSnapshot. A window's x/y are its layout slot in
+  // global layout coordinates, already scrolled along the strip, so the on-screen
+  // box is the slot minus the output's position. Only visible, unminimized
+  // windows count (`visible` already excludes other workspaces and hidden tabs).
+  // Pure, for tests.
+  live::WindowSnapshot parseWindowSnapshot(const nlohmann::json& windows, const nlohmann::json& outputs);
+
+  // Keeps the snapshot current. Structural changes arrive as `windows` events,
+  // but tiled moves and strip scrolling emit none, so while setPolling(true)
+  // (a live wallpaper needs the data) it also re-queries `windows` four times a
+  // second.
+  class UmbrielWindowTracker final : public UmbrielEventHandler {
+  public:
+    explicit UmbrielWindowTracker(UmbrielRuntime& runtime);
+    ~UmbrielWindowTracker() override;
+
+    void handleEvent(std::string_view event, const nlohmann::json& data) override;
+    void handleStreamReset() override;
+
+    void setPolling(bool polling);
+
+  private:
+    void poll();
+    void publish();
+
+    nlohmann::json m_windows = nlohmann::json::array();
+    nlohmann::json m_outputs = nlohmann::json::array();
+    Timer m_pollTimer;
+    bool m_polling = false;
+  };
+
+} // namespace compositors::umbriel
