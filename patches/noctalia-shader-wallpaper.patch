+void ShaderLiveWallpaper::setConsumerOutput(const void* consumer, std::string_view output) {
+  auto [it, inserted] = m_consumerOutputs.try_emplace(consumer, output);
+  if (!inserted && it->second == output) {
+    return;
+  }
+  it->second = std::string(output);
+  updateWindowDemand();
+}
+
+bool ShaderLiveWallpaper::outputPaused(const std::string& output) const {
+  if (m_locked || m_config.pauseWhenCovered == ShaderPause::Off || output.empty() || !live::windowProviderAvailable()) {
+    return false;
+  }
+  const auto& snapshot = live::windowSnapshot();
+  const auto it = snapshot.find(output);
+  return it != snapshot.end() && live::covered(it->second, m_config.pauseWhenCovered);
+}
+
+bool ShaderLiveWallpaper::paused(const void* consumer) const {
+  const auto it = m_consumerOutputs.find(consumer);
+  return it != m_consumerOutputs.end() && outputPaused(it->second);
+}
+
+bool ShaderLiveWallpaper::allPaused() const {
+  if (m_consumerOutputs.empty()) {
+    return false;
+  }
+  return std::ranges::all_of(m_consumerOutputs, [this](const auto& entry) { return outputPaused(entry.second); });
+}
+
+bool ShaderLiveWallpaper::usesWindows() const {
+  return std::ranges::any_of(m_programs, [](const auto& entry) {
+    const Program& program = entry.second;
+    if (program.image.program != 0 && program.image.uniforms.windowRects >= 0) {
+      return true;
+    }
+    return std::ranges::any_of(program.buffers, [](const Pass& pass) {
+      return pass.program != 0 && (pass.uniforms.windowRects >= 0 || pass.uniforms.windowCount >= 0);
+    });
+  });
+}
+
+void ShaderLiveWallpaper::updateWindowDemand() {
+  const bool wanted = !m_consumerOutputs.empty() && (m_config.pauseWhenCovered != ShaderPause::Off || usesWindows());
+  live::setWindowDemand(wanted);
+}
+
+void ShaderLiveWallpaper::onWindowsChanged() {
+  bool resumed = false;
+  for (const auto& [consumer, output] : m_consumerOutputs) {
+    const bool now = outputPaused(output);
+    auto [it, inserted] = m_pausedOutputs.try_emplace(output, false);
+    if (it->second != now || (inserted && now)) {
+      kLog.info("{}: {}", output, now ? "paused behind windows" : "resumed");
+      resumed = resumed || !now;
+      it->second = now;
+    }
+  }
+  if (usesWindows()) {
+    bumpGeneration(); // iWindowRects changed: shaders that read it repaint, even when still
+  }
+  if (resumed || usesWindows()) {
+    wake();
+  }
+}
+
+ShaderLiveWallpaper::FrameWindows ShaderLiveWallpaper::frameWindows(Target& target, double frameDelta) const {
+  FrameWindows out;
+  if (target.output.empty()) {
+    return out;
+  }
+  const auto& snapshot = live::windowSnapshot();
+  const auto it = snapshot.find(target.output);
+  if (it == snapshot.end() || it->second.width <= 0 || it->second.height <= 0) {
+    return out;
+  }
+  const auto ow = static_cast<float>(it->second.width);
+  const auto oh = static_cast<float>(it->second.height);
+  for (const live::WindowBox& w : it->second.windows) {
+    if (out.rects.size() == 16) {
+      break;
+    }
+    out.rects.push_back({
+        static_cast<float>(w.x) / ow,
+        (oh - static_cast<float>(w.y) - static_cast<float>(w.height)) / oh, // GL origin: bottom edge
+        static_cast<float>(w.width) / ow,
+        static_cast<float>(w.height) / oh,
+    });
+  }
+  const bool sameWindows = target.previousWindows.size() == out.rects.size();
+  for (std::size_t i = 0; i < out.rects.size(); ++i) {
+    const auto previous = sameWindows ? target.previousWindows[i] : out.rects[i];
+    out.previous.push_back(previous);
+    if (sameWindows && frameDelta > 0.0) {
+      out.velocities.push_back({
+          static_cast<float>((out.rects[i][0] - previous[0]) / frameDelta),
+          static_cast<float>((out.rects[i][1] - previous[1]) / frameDelta),
+      });
+    } else {
+      out.velocities.push_back({0.0F, 0.0F});
+    }
+  }
+  return out;
+}
