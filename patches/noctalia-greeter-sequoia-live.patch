+int GreeterSurface::pollLiveWallpaper() {
+  if (!m_wallpaperLive || m_liveWallpaper == nullptr || m_window == nullptr) {
+    return -1;
+  }
+  auto& live = SequoiaLive::instance();
+  if (!live.usable()) {
+    if (m_liveWallpaper->visible()) {
+      m_liveWallpaper->setVisible(false); // GPU failure: back to the still
+      requestRedraw();
+    }
+    return -1;
+  }
+  if (!m_livePrimed) {
+    // The synced still goes on screen first; the live scene takes over from the next frame.
+    if (m_framesPrepared == 0) {
+      return 16;
+    }
+    m_livePrimed = true;
+    m_liveWallpaper->setVisible(true);
+  }
+  if (live.frameDelayMs(this) != 0) {
+    return live.frameDelayMs(this);
+  }
+  m_liveWallpaper->invalidate();
+  requestRedraw();
+  const int next = live.frameDelayMs(this);
+  return next == 0 ? 16 : next; // the paint did not happen (deferred); try again shortly
