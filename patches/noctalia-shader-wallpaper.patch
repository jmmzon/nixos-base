+
+namespace {
+
+  constexpr Logger kLog("shader");
+
+  // Heartbeat slice; the frame loop re-arms it while frames are needed.
+  constexpr float kDriveSliceMs = 250.0F;
+  // Frame-cap slack so a 60 fps cap is not missed by sub-millisecond jitter.
+  constexpr auto kFrameSlack = std::chrono::microseconds(1500);
+  // Render targets unused this long are released (output removed or resized).
+  constexpr auto kTargetIdle = std::chrono::seconds(30);
+  // A frame this long after a shader loads (in iTime) becomes its still, so
+  // shaders that fade in from black are not captured at their first frame.
+  constexpr double kStillDelaySeconds = 2.0;
+  // iTime never jumps by more than this per advance (after a suspend, say).
+  constexpr double kMaxStepSeconds = 1.0;
+  constexpr std::string_view kStillPrefix = "shader-still-";
+  constexpr char kCacheMagic[4] = {'N', 'S', 'B', '1'};
+
+  // Saves the GL state a shader frame touches and restores it on scope exit.
+  class StateGuard {
+  public:
+    StateGuard() {
+      glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &m_drawFbo);
+      glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &m_readFbo);
+      glGetIntegerv(GL_VIEWPORT, m_viewport);
+      glGetIntegerv(GL_CURRENT_PROGRAM, &m_program);
+      glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &m_vao);
+      glGetIntegerv(GL_ACTIVE_TEXTURE, &m_activeTexture);
+      for (int unit = 0; unit < kUnits; ++unit) {
+        glActiveTexture(static_cast<GLenum>(GL_TEXTURE0 + unit));
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &m_textures[unit]);
+      }
+      m_scissor = glIsEnabled(GL_SCISSOR_TEST);
+      m_blend = glIsEnabled(GL_BLEND);
+      m_depthTest = glIsEnabled(GL_DEPTH_TEST);
+      m_cullFace = glIsEnabled(GL_CULL_FACE);
+      m_stencilTest = glIsEnabled(GL_STENCIL_TEST);
+      glGetBooleanv(GL_COLOR_WRITEMASK, m_colorMask);
+    }
+
+    ~StateGuard() {
+      glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(m_drawFbo));
+      glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(m_readFbo));
+      glViewport(m_viewport[0], m_viewport[1], m_viewport[2], m_viewport[3]);
+      glUseProgram(static_cast<GLuint>(m_program));
+      glBindVertexArray(static_cast<GLuint>(m_vao));
+      for (int unit = 0; unit < kUnits; ++unit) {
+        glActiveTexture(static_cast<GLenum>(GL_TEXTURE0 + unit));
+        glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(m_textures[unit]));
+      }
+      glActiveTexture(static_cast<GLenum>(m_activeTexture));
+      set(GL_SCISSOR_TEST, m_scissor);
+      set(GL_BLEND, m_blend);
+      set(GL_DEPTH_TEST, m_depthTest);
+      set(GL_CULL_FACE, m_cullFace);
+      set(GL_STENCIL_TEST, m_stencilTest);
+      glColorMask(m_colorMask[0], m_colorMask[1], m_colorMask[2], m_colorMask[3]);
+    }
+
+    StateGuard(const StateGuard&) = delete;
+    StateGuard& operator=(const StateGuard&) = delete;
+
+  private:
+    static constexpr int kUnits = 4;
+
+    static void set(GLenum cap, GLboolean on) {
+      if (on == GL_TRUE) {
+        glEnable(cap);
+      } else {
+        glDisable(cap);
+      }
+    }
+
+    GLint m_drawFbo = 0, m_readFbo = 0, m_viewport[4] = {}, m_program = 0, m_vao = 0;
+    GLint m_activeTexture = GL_TEXTURE0, m_textures[kUnits] = {};
+    GLboolean m_scissor = GL_FALSE, m_blend = GL_FALSE, m_depthTest = GL_FALSE, m_cullFace = GL_FALSE;
+    GLboolean m_stencilTest = GL_FALSE, m_colorMask[4] = {GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE};
+  };
+
+  std::string hex64(std::uint64_t value) { return std::format("{:016x}", value); }
+
+  std::string glString(GLenum name) {
+    const auto* text = reinterpret_cast<const char*>(glGetString(name));
+    return text != nullptr ? std::string(text) : std::string{};
+  }
+
+  int glesMajorVersion() {
+    int major = 0;
+    int minor = 0;
+    if (std::sscanf(glString(GL_VERSION).c_str(), "OpenGL ES %d.%d", &major, &minor) < 1) {
+      return 0;
+    }
+    return major;
+  }
+
+  std::filesystem::path binaryCacheDirectory() {
+    const std::string base = FileUtils::applicationXdgDir("CACHE_HOME", "XDG_CACHE_HOME", ".cache");
+    return base.empty() ? std::filesystem::path{} : std::filesystem::path(base) / "shaders";
+  }
+
+  // First lines of a GL info log, for the journal.
+  std::string shortLog(std::string log) {
+    constexpr std::size_t kMax = 1500;
+    if (log.size() > kMax) {
+      log.resize(kMax);
+      log += "…";
+    }
+    while (!log.empty() && (log.back() == '\n' || log.back() == '\0')) {
+      log.pop_back();
+    }
+    return log;
+  }
+
+  GLuint compileStage(GLenum type, const std::string& source, std::string& error) {
+    const GLuint shader = glCreateShader(type);
+    const char* text = source.c_str();
+    glShaderSource(shader, 1, &text, nullptr);
+    glCompileShader(shader);
+    GLint ok = GL_FALSE;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (ok != GL_TRUE) {
+      GLint length = 0;
+      glGetShaderiv(shader, GL_INFO_LOG_LENGTH, &length);
+      std::string log(static_cast<std::size_t>(std::max(length, 1)), '\0');
+      glGetShaderInfoLog(shader, length, nullptr, log.data());
+      error = shortLog(std::move(log));
+      glDeleteShader(shader);
+      return 0;
+    }
+    return shader;
+  }
+
+  bool programLinked(GLuint program) {
+    GLint ok = GL_FALSE;
+    glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    return ok == GL_TRUE;
+  }
+
+  // Program from the binary cache, or 0.
+  GLuint loadCachedProgram(const std::filesystem::path& file) {
+    std::ifstream in(file, std::ios::binary);
+    if (!in) {
+      return 0;
+    }
+    char magic[4] = {};
+    std::uint32_t format = 0;
+    in.read(magic, sizeof(magic));
+    in.read(reinterpret_cast<char*>(&format), sizeof(format));
+    if (!in || std::memcmp(magic, kCacheMagic, sizeof(magic)) != 0) {
+      return 0;
+    }
+    const std::vector<char> data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    if (data.empty()) {
+      return 0;
+    }
+    const GLuint program = glCreateProgram();
+    glProgramBinary(program, format, data.data(), static_cast<GLsizei>(data.size()));
+    if (glGetError() != GL_NO_ERROR || !programLinked(program)) {
+      glDeleteProgram(program);
+      std::error_code ec;
+      std::filesystem::remove(file, ec); // stale (driver update); rebuilt below
+      return 0;
+    }
+    return program;
+  }
+
+  void storeCachedProgram(GLuint program, const std::filesystem::path& file) {
+    GLint length = 0;
+    glGetProgramiv(program, GL_PROGRAM_BINARY_LENGTH, &length);
+    if (length <= 0) {
+      return;
+    }
+    std::vector<char> data(static_cast<std::size_t>(length));
+    GLenum format = 0;
+    glGetProgramBinary(program, length, nullptr, &format, data.data());
+    if (glGetError() != GL_NO_ERROR) {
+      return;
+    }
+    std::error_code ec;
+    std::filesystem::create_directories(file.parent_path(), ec);
+    const auto tmp = std::filesystem::path(file.string() + ".tmp");
+    {
+      std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+      const auto format32 = static_cast<std::uint32_t>(format);
+      out.write(kCacheMagic, sizeof(kCacheMagic));
+      out.write(reinterpret_cast<const char*>(&format32), sizeof(format32));
+      out.write(data.data(), static_cast<std::streamsize>(data.size()));
+      if (!out) {
+        std::filesystem::remove(tmp, ec);
+        return;
+      }
+    }
+    std::filesystem::rename(tmp, file, ec);
+  }
+
+  // Links vs + fs, through the program binary cache when the driver supports it.
+  GLuint linkProgram(const std::string& vs, const std::string& fs, std::string& error, bool& fromCache) {
+    fromCache = false;
+    GLint formats = 0;
+    glGetIntegerv(GL_NUM_PROGRAM_BINARY_FORMATS, &formats);
+    std::filesystem::path cacheFile;
+    if (formats > 0) {
+      const std::filesystem::path dir = binaryCacheDirectory();
+      if (!dir.empty()) {
+        const std::string driver = glString(GL_VENDOR) + '\n' + glString(GL_RENDERER) + '\n' + glString(GL_VERSION);
+        cacheFile = dir / (hex64(shader::fnv1a(vs + '\n' + fs + '\n' + driver)) + ".bin");
+        if (const GLuint cached = loadCachedProgram(cacheFile); cached != 0) {
+          fromCache = true;
+          return cached;
+        }
+      }
+    }
+    const GLuint v = compileStage(GL_VERTEX_SHADER, vs, error);
+    if (v == 0) {
+      return 0;
+    }
+    const GLuint f = compileStage(GL_FRAGMENT_SHADER, fs, error);
+    if (f == 0) {
+      glDeleteShader(v);
+      return 0;
+    }
+    const GLuint program = glCreateProgram();
+    glAttachShader(program, v);
+    glAttachShader(program, f);
+    if (!cacheFile.empty()) {
+      glProgramParameteri(program, GL_PROGRAM_BINARY_RETRIEVABLE_HINT, GL_TRUE);
+    }
+    glLinkProgram(program);
+    glDeleteShader(v);
+    glDeleteShader(f);
+    if (!programLinked(program)) {
+      GLint length = 0;
+      glGetProgramiv(program, GL_INFO_LOG_LENGTH, &length);
+      std::string log(static_cast<std::size_t>(std::max(length, 1)), '\0');
+      glGetProgramInfoLog(program, length, nullptr, log.data());
+      error = shortLog(std::move(log));
+      glDeleteProgram(program);
+      return 0;
+    }
+    if (!cacheFile.empty()) {
+      storeCachedProgram(program, cacheFile);
+    }
+    return program;
+  }
+
+  std::filesystem::file_time_type modificationTime(const std::filesystem::path& file) {
+    std::error_code ec;
+    const auto time = std::filesystem::last_write_time(file, ec);
+    return ec ? std::filesystem::file_time_type{} : time;
+  }
+
+} // namespace
+
+ShaderLiveWallpaper& ShaderLiveWallpaper::instance() {
+  // Intentionally leaked: GL objects must not be destroyed after the context is gone.
+  static auto* live = new ShaderLiveWallpaper();
+  return *live;
+}
+
+ShaderLiveWallpaper::ShaderLiveWallpaper() : m_lastAdvance(std::chrono::steady_clock::now()) {
+  m_time = m_config.desktopMotion == ShaderMotion::Animated ? 0.0 : static_cast<double>(m_config.stillTime);
+}
+
+ShaderLiveWallpaper::~ShaderLiveWallpaper() = default;
+
+bool ShaderLiveWallpaper::handlesPath(std::string_view path) const { return shader::isShaderPath(path); }
+
+bool ShaderLiveWallpaper::animating() const {
+  const ShaderMotion motion = m_locked ? m_config.lockMotion : m_config.desktopMotion;
+  if (motion != ShaderMotion::Animated || m_config.speed <= 0.0F) {
+    return false;
+  }
+  return std::ranges::any_of(m_programs, [](const auto& entry) {
+    return entry.second.program != 0 && !entry.second.failed;
+  });
+}
+
+std::int32_t ShaderLiveWallpaper::frameRate() const {
+  return std::max<std::int32_t>(1, m_locked ? m_config.lockFps : m_config.desktopFps);
+}
+
+void ShaderLiveWallpaper::setConfig(const WallpaperConfig& config) {
+  const WallpaperShaderConfig& next = config.shader;
+  if (next == m_config) {
+    return;
+  }
+  const bool directoriesChanged = next.directories != m_config.directories;
+  const bool stillChanged = next.stillTime != m_config.stillTime;
+  m_config = next;
+  if (directoriesChanged) {
+    for (auto& [spec, program] : m_programs) {
+      program.reload = true; // look the file up again in the new directories
+    }
+  }
+  setLocked(m_locked); // applies the motion mode for the current state
+  if (stillChanged) {
+    for (auto& [spec, program] : m_programs) {
+      program.stillWanted = true;
+    }
+  }
+}
+
+void ShaderLiveWallpaper::setLocked(bool locked) {
+  advance();
+  m_locked = locked;
+  const ShaderMotion motion = locked ? m_config.lockMotion : m_config.desktopMotion;
+  if (motion == ShaderMotion::Still) {
+    m_time = static_cast<double>(m_config.stillTime);
+    m_timeDelta = 0.0;
+    bumpGeneration();
+  }
+  m_lastAdvance = std::chrono::steady_clock::now();
+  wake();
+}
+
+void ShaderLiveWallpaper::advance() {
+  const auto now = std::chrono::steady_clock::now();
+  const double dt = std::min(std::chrono::duration<double>(now - m_lastAdvance).count(), kMaxStepSeconds);
+  m_lastAdvance = now;
+  if (now - m_lastFileCheck >= std::chrono::seconds(1)) {
+    checkFiles(false);
+  }
+  if (dt <= 0.0 || !animating()) {
+    return;
+  }
+  m_timeDelta = dt * static_cast<double>(m_config.speed);
+  m_time += m_timeDelta;
+  bumpGeneration();
+}
+
+bool ShaderLiveWallpaper::needsFrames(const void* consumer) const {
+  if (animating()) {
+    return true;
+  }
+  const auto it = m_consumers.find(consumer);
+  return it == m_consumers.end() || it->second.paintedGeneration != m_generation;
+}
+
+bool ShaderLiveWallpaper::takeRepaint(const void* consumer) {
+  ConsumerState& state = m_consumers[consumer];
+  if (state.paintedGeneration == m_generation) {
+    return false;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (animating()) {
+    const auto interval = std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+        std::chrono::duration<double>(1.0 / static_cast<double>(frameRate()))
+    );
+    if (now - state.lastPaint + kFrameSlack < interval) {
+      return false;
+    }
+  }
+  state.paintedGeneration = m_generation;
+  state.lastPaint = now;
+  return true;
+}
+
+void ShaderLiveWallpaper::forgetConsumer(const void* consumer) {
+  m_consumers.erase(consumer);
+  for (auto it = m_targets.begin(); it != m_targets.end();) {
+    if (it->first.first == consumer) {
+      m_retired.push_back(it->second); // GL names are deleted when a context is current
+      it = m_targets.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+void ShaderLiveWallpaper::driveFrames(
+    AnimationManager& animations, const void* consumer, std::function<void()> onTick
+) {
+  // Update callbacks run on every frame tick, so arming must depend on need, or
+  // the heartbeat would keep itself alive forever.
+  if (!needsFrames(consumer)) {
+    return;
+  }
+  ConsumerState& state = m_consumers[consumer];
+  if (state.driving) {
+    return;
+  }
+  state.driving = true;
+  animations.animateTimer(
+      0.0F, 1.0F, kDriveSliceMs, Easing::Linear, [onTick](float) { onTick(); },
+      [this, &animations, consumer, onTick] {
+        auto it = m_consumers.find(consumer);
+        if (it == m_consumers.end()) {
+          return;
+        }
+        it->second.driving = false;
+        if (needsFrames(consumer)) {
+          driveFrames(animations, consumer, onTick);
+        }
+      },
+      consumer
+  );
+  onTick();
+}
+
+std::uint64_t ShaderLiveWallpaper::addWakeListener(std::function<void()> callback) {
+  const std::uint64_t id = m_nextListenerId++;
+  m_wakeListeners.emplace(id, std::move(callback));
+  return id;
+}
+
+void ShaderLiveWallpaper::removeWakeListener(std::uint64_t id) { m_wakeListeners.erase(id); }
+
+void ShaderLiveWallpaper::wake() {
+  // Copy: a listener may add or remove listeners.
+  std::vector<std::function<void()>> listeners;
+  listeners.reserve(m_wakeListeners.size());
+  for (const auto& [id, fn] : m_wakeListeners) {
+    listeners.push_back(fn);
+  }
+  for (auto& fn : listeners) {
+    fn();
+  }
+}
+
+void ShaderLiveWallpaper::setStillChangedCallback(std::function<void()> callback) {
+  m_stillChanged = std::move(callback);
+}
+
+std::string ShaderLiveWallpaper::stillPrefix(std::string_view spec) const {
+  return std::string(kStillPrefix) + hex64(shader::fnv1a(spec)) + "-";
+}
+
+std::string ShaderLiveWallpaper::stillPathFor(std::string_view path) const {
+  const std::string spec = shader::shaderSpec(path);
+  if (spec.empty()) {
+    return {};
+  }
+  if (const auto it = m_stills.find(spec); it != m_stills.end()) {
+    return it->second;
+  }
+  // After a restart, reuse the newest still from the previous run until a new one is written.
+  const std::string prefix = stillPrefix(spec);
+  std::filesystem::path newest;
+  std::filesystem::file_time_type newestTime{};
+  std::error_code ec;
+  const std::string state = FileUtils::stateDir();
+  if (!state.empty()) {
+    for (const auto& entry : std::filesystem::directory_iterator(state, ec)) {
+      const std::string name = entry.path().filename().string();
+      if (name.starts_with(prefix) && name.ends_with(".png")) {
+        const auto time = entry.last_write_time(ec);
+        if (newest.empty() || time > newestTime) {
+          newest = entry.path();
+          newestTime = time;
+        }
+      }
+    }
+  }
+  m_stills[spec] = newest.string();
+  return newest.string();
+}
+
+void ShaderLiveWallpaper::onSecondTick() { checkFiles(true); }
+
+void ShaderLiveWallpaper::checkFiles(bool includeMissing) {
+  m_lastFileCheck = std::chrono::steady_clock::now();
+  bool changed = false;
+  for (auto& [spec, program] : m_programs) {
+    if (!program.resolved || program.reload) {
+      continue;
+    }
+    if (program.file.empty()) {
+      if (!includeMissing) {
+        continue;
+      }
+      // Not found last time: it may have been installed since.
+      const auto file = shader::resolveShaderFile(
+          std::string(shader::kPathPrefix) + spec, shader::searchDirectories(m_config.directories)
+      );
+      if (file.has_value()) {
+        program.reload = true;
+        changed = true;
+      }
+      continue;
+    }
+    if (modificationTime(program.file) != program.mtime) {
+      kLog.info("{} changed; reloading", program.file.string());
+      program.reload = true;
+      changed = true;
+    }
+  }
+  if (changed) {
+    bumpGeneration();
+    DeferredCall::callLater([this] { wake(); }); // may run inside a frame tick
+  }
+}
+
+ShaderLiveWallpaper::Program& ShaderLiveWallpaper::programFor(const std::string& spec) {
+  auto [it, inserted] = m_programs.try_emplace(spec);
+  if (inserted) {
+    it->second.spec = spec;
+  }
+  return it->second;
+}
+
+void ShaderLiveWallpaper::resolve(Program& program) {
+  program.resolved = true;
+  const auto dirs = shader::searchDirectories(m_config.directories);
+  const auto file = shader::resolveShaderFile(std::string(shader::kPathPrefix) + program.spec, dirs);
+  if (!file.has_value()) {
+    std::string searched;
+    for (const auto& dir : dirs) {
+      searched += (searched.empty() ? "" : ", ") + dir.string();
+    }
+    kLog.warn("shader '{}' not found (searched {})", program.spec, searched);
+    program.file.clear();
+    program.failed = true;
+    return;
+  }
+  program.file = *file;
+  program.mtime = modificationTime(*file);
+}
+
+bool ShaderLiveWallpaper::ensureCompiled(Program& program) {
+  if (program.reload) {
+    if (program.program != 0) {
+      glDeleteProgram(program.program);
+    }
+    program.program = 0;
+    program.failed = false;
+    program.resolved = false;
+    program.reload = false;
+  }
+  if (!program.resolved) {
+    resolve(program);
+  }
+  if (program.failed) {
+    return false;
+  }
+  if (program.program != 0) {
+    return true;
+  }
+
+  std::ifstream in(program.file, std::ios::binary);
+  std::stringstream text;
+  text << in.rdbuf();
+  if (!in) {
+    kLog.warn("cannot read {}", program.file.string());
+    program.failed = true;
+    return false;
+  }
+  const std::string source = text.str();
+  program.mtime = modificationTime(program.file);
+  program.flip = shader::classifySource(source) == shader::SourceKind::Complete;
+
+  const auto started = std::chrono::steady_clock::now();
+  std::string error;
+  bool fromCache = false;
+  const GLuint id =
+      linkProgram(std::string(shader::vertexSource()), shader::assembleFragmentSource(source), error, fromCache);
+  const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started);
+  if (id == 0) {
+    kLog.warn("{}: {}", program.file.string(), error);
+    program.failed = true;
+    return false;
+  }
+  program.program = id;
+  Uniforms& u = program.uniforms;
+  u.resolution = glGetUniformLocation(id, "iResolution");
+  u.time = glGetUniformLocation(id, "iTime");
+  u.timeDelta = glGetUniformLocation(id, "iTimeDelta");
+  u.frame = glGetUniformLocation(id, "iFrame");
+  u.frameRate = glGetUniformLocation(id, "iFrameRate");
+  u.mouse = glGetUniformLocation(id, "iMouse");
+  u.date = glGetUniformLocation(id, "iDate");
+  u.sampleRate = glGetUniformLocation(id, "iSampleRate");
+  u.channelTime = glGetUniformLocation(id, "iChannelTime");
+  u.channelResolution = glGetUniformLocation(id, "iChannelResolution");
+  u.screenOffset = glGetUniformLocation(id, "iScreenOffset");
+  u.desktopResolution = glGetUniformLocation(id, "iDesktopResolution");
+  u.screenIndex = glGetUniformLocation(id, "iScreenIndex");
+  u.screenCount = glGetUniformLocation(id, "iScreenCount");
+  for (int i = 0; i < 4; ++i) {
+    u.channel[i] = glGetUniformLocation(id, std::format("iChannel{}", i).c_str());
+  }
+  program.loadedAtTime = m_time;
+  program.stillWanted = true;
+  kLog.info("{}: ready in {} ms{}", program.file.string(), ms.count(), fromCache ? " (cached)" : "");
+  // Frames may be needed now (an animated shader became usable); not from inside Render.
+  DeferredCall::callLater([this] { wake(); });
+  return true;
+}
+
+bool ShaderLiveWallpaper::ensureCommonObjects() {
+  if (m_vao != 0) {
+    return true;
+  }
+  if (glesMajorVersion() < 3) {
+    kLog.warn("needs OpenGL ES 3.0 (have '{}')", glString(GL_VERSION));
+    m_glFailed = true;
+    return false;
+  }
+  glGenVertexArrays(1, &m_vao);
+  glGenTextures(1, &m_blackTexture);
+  GLint previous = 0;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous);
+  glBindTexture(GL_TEXTURE_2D, m_blackTexture);
+  const std::uint8_t black[4] = {0, 0, 0, 255};
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, black);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(previous));
+  return true;
+}
+
+bool ShaderLiveWallpaper::ensureTarget(Target& target, int width, int height, bool flip) {
+  if (target.fbo != 0 && target.width == width && target.height == height && flip == (target.flipFbo != 0)) {
+    return true;
+  }
+  destroyTarget(target);
+  GLint previousTexture = 0;
+  GLint previousFbo = 0;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &previousTexture);
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &previousFbo);
+  const auto make = [width, height](GLuint& fbo, GLuint& texture) {
+    glGenTextures(1, &texture);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glGenFramebuffers(1, &fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0);
+    return glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+  };
+  bool ok = make(target.fbo, target.texture);
+  if (ok && flip) {
+    ok = make(target.flipFbo, target.flipTexture);
+  }
+  glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(previousTexture));
+  glBindFramebuffer(GL_FRAMEBUFFER, static_cast<GLuint>(previousFbo));
+  if (!ok) {
+    kLog.warn("cannot create a {}x{} render target", width, height);
+    destroyTarget(target);
+    return false;
+  }
+  target.width = width;
+  target.height = height;
+  target.renderedGeneration = 0;
+  target.frame = 0;
+  return true;
+}
+
+void ShaderLiveWallpaper::destroyTarget(Target& target) {
+  const GLuint fbos[] = {target.fbo, target.flipFbo};
+  const GLuint textures[] = {target.texture, target.flipTexture};
+  glDeleteFramebuffers(2, fbos);
+  glDeleteTextures(2, textures);
+  target = Target{};
+}
+
+void ShaderLiveWallpaper::releaseRetired() {
+  for (Target& target : m_retired) {
+    destroyTarget(target);
+  }
+  m_retired.clear();
+  const auto now = std::chrono::steady_clock::now();
+  for (auto it = m_targets.begin(); it != m_targets.end();) {
+    if (now - it->second.lastUsed > kTargetIdle) {
+      destroyTarget(it->second);
+      it = m_targets.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+void ShaderLiveWallpaper::render(Program& program, Target& target, const LiveFrameRequest& request) {
+  StateGuard guard;
+  const auto w = static_cast<float>(target.width);
+  const auto h = static_cast<float>(target.height);
+
+  glBindFramebuffer(GL_FRAMEBUFFER, target.fbo);
+  glViewport(0, 0, target.width, target.height);
+  glDisable(GL_BLEND);
+  glDisable(GL_DEPTH_TEST);
+  glDisable(GL_SCISSOR_TEST);
+  glDisable(GL_CULL_FACE);
+  glDisable(GL_STENCIL_TEST);
+  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+  glUseProgram(program.program);
+
+  const Uniforms& u = program.uniforms;
+  const auto time = static_cast<float>(m_time);
+  glUniform3f(u.resolution, w, h, 1.0F);
+  glUniform1f(u.time, time);
+  glUniform1f(u.timeDelta, static_cast<float>(m_timeDelta));
+  glUniform1i(u.frame, target.frame);
+  glUniform1f(u.frameRate, static_cast<float>(frameRate()));
+  glUniform4f(u.mouse, 0.0F, 0.0F, 0.0F, 0.0F);
+  const std::time_t now = std::time(nullptr);
+  std::tm local{};
+  localtime_r(&now, &local);
+  glUniform4f(
+      u.date, static_cast<float>(local.tm_year + 1900), static_cast<float>(local.tm_mon),
+      static_cast<float>(local.tm_mday), static_cast<float>(local.tm_hour * 3600 + local.tm_min * 60 + local.tm_sec)
+  );
+  glUniform1f(u.sampleRate, 44100.0F);
+  const float channelTimes[4] = {time, time, time, time};
+  const float channelResolutions[12] = {};
+  glUniform1fv(u.channelTime, 4, channelTimes);
+  glUniform3fv(u.channelResolution, 4, channelResolutions);
+
+  // Span geometry is in logical pixels; the shader works in this target's pixels
+  // with a bottom-left origin.
+  const WallpaperSpanParams& span = request.span;
+  if (span.totalWidth > 0.0F && span.totalHeight > 0.0F && span.monitorWidth > 0.0F && span.monitorHeight > 0.0F) {
+    const float sx = w / span.monitorWidth;
+    const float sy = h / span.monitorHeight;
+    glUniform2f(u.screenOffset, span.offsetX * sx, (span.totalHeight - span.offsetY - span.monitorHeight) * sy);
+    glUniform2f(u.desktopResolution, span.totalWidth * sx, span.totalHeight * sy);
+  } else {
+    glUniform2f(u.screenOffset, 0.0F, 0.0F);
+    glUniform2f(u.desktopResolution, w, h);
+  }
+  glUniform1i(u.screenIndex, 0);
+  glUniform1i(u.screenCount, 1);
+
+  for (int i = 0; i < 4; ++i) {
+    glActiveTexture(static_cast<GLenum>(GL_TEXTURE0 + i));
+    glBindTexture(GL_TEXTURE_2D, m_blackTexture);
+    glUniform1i(u.channel[i], i);
+  }
+  glActiveTexture(GL_TEXTURE0);
+
+  glBindVertexArray(m_vao);
+  glDrawArrays(GL_TRIANGLES, 0, 3);
+
+  if (program.flip) {
+    // Its own main() writes rows bottom-up; Noctalia samples top row first.
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, target.fbo);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, target.flipFbo);
+    glBlitFramebuffer(
+        0, 0, target.width, target.height, 0, target.height, target.width, 0, GL_COLOR_BUFFER_BIT, GL_NEAREST
+    );
+  }
+  ++target.frame;
+  target.renderedGeneration = m_generation;
+}
+
+TextureHandle ShaderLiveWallpaper::frameTexture(const LiveFrameRequest& request) {
+  if (request.width <= 0 || request.height <= 0 || m_glFailed) {
+    return {};
+  }
+  const std::string spec = shader::shaderSpec(request.path);
+  if (spec.empty()) {
+    return {};
+  }
+  releaseRetired();
+  Program& program = programFor(spec);
+  if (!ensureCommonObjects() || !ensureCompiled(program)) {
+    return {};
+  }
+
+  const float scale = std::clamp(m_config.renderScale, 0.1F, 1.0F);
+  const int w = std::max(1, static_cast<int>(std::lround(static_cast<float>(request.width) * scale)));
+  const int h = std::max(1, static_cast<int>(std::lround(static_cast<float>(request.height) * scale)));
+  Target& target = m_targets[{request.consumer, spec}];
+  target.lastUsed = std::chrono::steady_clock::now();
+  if (!ensureTarget(target, w, h, program.flip)) {
+    return {};
+  }
+  if (target.renderedGeneration != m_generation) {
+    render(program, target, request);
+  }
+  maybeCaptureStill(program, target);
+  const GLuint texture = program.flip ? target.flipTexture : target.texture;
+  return TextureHandle{
+      .id = TextureId(texture),
+      .width = w,
+      .height = h,
+      .sourceWidth = w,
+      .sourceHeight = h,
+      .generation = m_generation,
+      .opaque = true,
+  };
+}
+
+void ShaderLiveWallpaper::maybeCaptureStill(Program& program, const Target& target) {
+  if (!program.stillWanted || m_stillWriting) {
+    return;
+  }
+  if (animating() && m_time - program.loadedAtTime < kStillDelaySeconds) {
+    return; // let fade-ins finish first
+  }
+  const std::string state = FileUtils::stateDir();
+  program.stillWanted = false;
+  if (state.empty()) {
+    return;
+  }
+  std::vector<std::uint8_t> rgba(static_cast<std::size_t>(target.width) * static_cast<std::size_t>(target.height) * 4);
+  {
+    GLint previousRead = 0;
+    GLint packAlignment = 4;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &previousRead);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &packAlignment);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, program.flip ? target.flipFbo : target.fbo);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    // Row 0 of the texture is the top of the image, so this is already top-down.
+    glReadPixels(0, 0, target.width, target.height, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+    glPixelStorei(GL_PACK_ALIGNMENT, packAlignment);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(previousRead));
+    if (glGetError() != GL_NO_ERROR) {
+      kLog.warn("still readback failed for '{}'", program.spec);
+      return;
+    }
+  }
+  const auto stamp =
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch())
+          .count();
+  const std::string prefix = stillPrefix(program.spec);
+  const std::string path = (std::filesystem::path(state) / (prefix + std::to_string(stamp) + ".png")).string();
+  const std::string spec = program.spec;
+  m_stillWriting = true;
+  std::thread([this, rgba = std::move(rgba), width = target.width, height = target.height, path, prefix, spec] {
+    std::string error;
+    const std::vector<std::uint8_t> png = encodePng(rgba.data(), width, height, &error);
+    bool ok = !png.empty();
+    if (ok) {
+      std::error_code ec;
+      std::filesystem::create_directories(std::filesystem::path(path).parent_path(), ec);
+      const std::string tmp = path + ".tmp";
+      std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+      out.write(reinterpret_cast<const char*>(png.data()), static_cast<std::streamsize>(png.size()));
+      out.close();
+      ok = static_cast<bool>(out);
+      if (ok) {
+        std::filesystem::rename(tmp, path, ec);
+        ok = !ec;
+      }
+    }
+    DeferredCall::callLater([this, ok, error, path, prefix, spec] {
+      m_stillWriting = false;
+      if (!ok) {
+        kLog.warn("cannot write still frame: {}", error.empty() ? "I/O error" : error);
+        return;
+      }
+      m_stills[spec] = path;
+      std::error_code ec;
+      for (const auto& entry : std::filesystem::directory_iterator(std::filesystem::path(path).parent_path(), ec)) {
+        const std::string name = entry.path().filename().string();
+        if (name.starts_with(prefix) && name.ends_with(".png") && entry.path() != std::filesystem::path(path)) {
+          std::filesystem::remove(entry.path(), ec);
+        }
+      }
+      if (m_stillChanged) {
+        m_stillChanged();
+      }
+    });
+  }).detach();
+}
+
+void ShaderLiveWallpaper::abandonGpuResources() {
+  for (auto& [spec, program] : m_programs) {
+    program.program = 0;
+    if (!program.file.empty()) {
+      program.failed = false;
+    }
+  }
+  m_targets.clear();
+  m_retired.clear();
+  m_vao = 0;
+  m_blackTexture = 0;
+  m_glFailed = false;
+  for (auto& [consumer, state] : m_consumers) {
+    state.paintedGeneration = 0;
+  }
+}
diff --git a/src/shell/shader/shader_live_wallpaper.h b/src/shell/shader/shader_live_wallpaper.h
new file mode 100644
index 000000000..c7c330fe1
--- /dev/null
+++ b/src/shell/shader/shader_live_wallpaper.h
@@ -0,0 +1,148 @@
+#pragma once
+
+// Live "shader:" wallpaper: runs Shadertoy-style GLSL fragment shaders (for
+// example KDE Shader Wallpaper's library) as a wallpaper. Phase 1: single pass,
+// no channel inputs (iChannel0-3 are bound to black with iChannelResolution 0).
+// Design: docs/shader-wallpaper-design.md.
+//
+// One GL program per shader path, shared by every output and lock surface showing
+// it; one render target per (consumer, path), since iResolution and the span
+// offsets differ per output. iTime is shared, so the desktop and the lock screen
+// show the same moment.
+//
+// Threading: main thread only. frameTexture() must run in the Render phase with a
+// GL context of the shared Noctalia context group current.
+
+#include "config/config_types.h"
+#include "shell/live/live_wallpaper.h"
+
+#include <GLES3/gl3.h>
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <map>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+class ShaderLiveWallpaper final : public LiveWallpaperSource {
+public:
+  static ShaderLiveWallpaper& instance();
+
+  ShaderLiveWallpaper(const ShaderLiveWallpaper&) = delete;
+  ShaderLiveWallpaper& operator=(const ShaderLiveWallpaper&) = delete;
+
+  bool handlesPath(std::string_view path) const override;
+  void setConfig(const WallpaperConfig& config) override;
+  void setLocked(bool locked) override;
+
+  void advance() override;
+  bool needsFrames(const void* consumer) const override;
+  bool takeRepaint(const void* consumer) override;
+  void forgetConsumer(const void* consumer) override;
+  void driveFrames(AnimationManager& animations, const void* consumer, std::function<void()> onTick) override;
+
+  TextureHandle frameTexture(const LiveFrameRequest& request) override;
+
+  std::uint64_t addWakeListener(std::function<void()> callback) override;
+  void removeWakeListener(std::uint64_t id) override;
+
+  std::string stillPathFor(std::string_view path) const override;
+  void setStillChangedCallback(std::function<void()> callback) override;
+
+  // Reloads shaders whose file changed (or appeared) since they were compiled.
+  // Also checked from advance() at most once a second: Noctalia's "second" tick
+  // runs only once a minute unless a seconds clock is shown.
+  void onSecondTick() override;
+  void abandonGpuResources() override;
+
+private:
+  ShaderLiveWallpaper();
+  ~ShaderLiveWallpaper() override;
+
+  struct Uniforms {
+    GLint resolution = -1, time = -1, timeDelta = -1, frame = -1, frameRate = -1, mouse = -1, date = -1;
+    GLint sampleRate = -1, channelTime = -1, channelResolution = -1, screenOffset = -1, desktopResolution = -1;
+    GLint screenIndex = -1, screenCount = -1;
+    GLint channel[4] = {-1, -1, -1, -1};
+  };
+
+  // One shader path ("shader:<spec>").
+  struct Program {
+    std::string spec;
+    std::filesystem::path file; // resolved file ("" when not found)
+    std::filesystem::file_time_type mtime{};
+    bool resolved = false; // file lookup ran
+    bool failed = false;   // missing, compile or link error; retried when the file changes
+    bool reload = false;   // the file changed: recompile on the next frame
+    GLuint program = 0;
+    bool flip = false; // own main(): rendered bottom-up, flipped by a blit
+    Uniforms uniforms;
+    double loadedAtTime = 0.0; // iTime when it was compiled
+    bool stillWanted = false;  // capture the next suitable frame as the still
+  };
+
+  struct Target {
+    int width = 0;
+    int height = 0;
+    GLuint fbo = 0;
+    GLuint texture = 0;
+    GLuint flipFbo = 0; // only for Program::flip
+    GLuint flipTexture = 0;
+    std::uint64_t renderedGeneration = 0;
+    std::int32_t frame = 0;
+    std::chrono::steady_clock::time_point lastUsed{};
+  };
+
+  struct ConsumerState {
+    std::uint64_t paintedGeneration = 0;
+    std::chrono::steady_clock::time_point lastPaint{};
+    bool driving = false;
+  };
+
+  bool animating() const;
+  std::int32_t frameRate() const;
+  void wake();
+  // includeMissing: also look again for shaders that were not found (a directory scan).
+  void checkFiles(bool includeMissing);
+  void bumpGeneration() { ++m_generation; }
+
+  Program& programFor(const std::string& spec);
+  void resolve(Program& program);
+  bool ensureCompiled(Program& program);
+  bool ensureCommonObjects();
+  bool ensureTarget(Target& target, int width, int height, bool flip);
+  void render(Program& program, Target& target, const LiveFrameRequest& request);
+  void maybeCaptureStill(Program& program, const Target& target);
+  void destroyTarget(Target& target);
+  void releaseRetired();
+  std::string stillPrefix(std::string_view spec) const;
+
+  WallpaperShaderConfig m_config;
+  bool m_locked = false;
+
+  double m_time = 0.0;      // iTime
+  double m_timeDelta = 0.0; // iTimeDelta of the newest frame
+  std::uint64_t m_generation = 1;
+  std::chrono::steady_clock::time_point m_lastAdvance{};
+  std::chrono::steady_clock::time_point m_lastFileCheck{};
+
+  std::map<std::string, Program> m_programs; // by spec
+  std::map<std::pair<const void*, std::string>, Target> m_targets;
+  std::vector<Target> m_retired; // released consumers' targets, deleted when a context is current
+  GLuint m_vao = 0;
+  GLuint m_blackTexture = 0;
+  bool m_glFailed = false;
+
+  std::unordered_map<const void*, ConsumerState> m_consumers;
+  std::map<std::uint64_t, std::function<void()>> m_wakeListeners;
+  std::uint64_t m_nextListenerId = 1;
+
+  // Still frames, per spec: newest file, and whether the state dir was scanned for it.
+  mutable std::map<std::string, std::string> m_stills;
+  bool m_stillWriting = false;
+  std::function<void()> m_stillChanged;
+};
diff --git a/src/shell/shader/shader_source.cpp b/src/shell/shader/shader_source.cpp
new file mode 100644
index 000000000..1576c9d54
--- /dev/null
+++ b/src/shell/shader/shader_source.cpp
@@ -0,0 +1,255 @@
+#include "shell/shader/shader_source.h"
+
+#include "util/file_utils.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <regex>
+#include <system_error>
+
+namespace shader {
+
+  namespace {
+
+    std::string_view trim(std::string_view s) {
+      const auto first = s.find_first_not_of(" \t\r\n");
+      if (first == std::string_view::npos) {
+        return {};
+      }
+      const auto last = s.find_last_not_of(" \t\r\n");
+      return s.substr(first, last - first + 1);
+    }
+
+    std::string envOr(const char* name, std::string_view fallback) {
+      const char* value = std::getenv(name);
+      return value != nullptr && value[0] != '\0' ? std::string(value) : std::string(fallback);
+    }
+
+    bool isRegularFile(const std::filesystem::path& path) {
+      std::error_code ec;
+      return std::filesystem::is_regular_file(path, ec) && !ec;
+    }
+
+    // Source with comments blanked, so declarations inside comments do not count.
+    std::string withoutComments(std::string_view source) {
+      std::string out;
+      out.reserve(source.size());
+      for (std::size_t i = 0; i < source.size(); ++i) {
+        if (source[i] == '/' && i + 1 < source.size() && source[i + 1] == '/') {
+          while (i < source.size() && source[i] != '\n') {
+            ++i;
+          }
+          out.push_back('\n');
+        } else if (source[i] == '/' && i + 1 < source.size() && source[i + 1] == '*') {
+          i += 2;
+          while (i + 1 < source.size() && !(source[i] == '*' && source[i + 1] == '/')) {
+            out.push_back(source[i] == '\n' ? '\n' : ' ');
+            ++i;
+          }
+          ++i;
+        } else {
+          out.push_back(source[i]);
+        }
+      }
+      return out;
+    }
+
+    bool declaresUniform(const std::string& code, std::string_view name) {
+      const std::regex re("\\buniform\\s+[^;]*\\b" + std::string(name) + "\\b");
+      return std::regex_search(code, re);
+    }
+
+    // Declarations, in kUniformNames order.
+    constexpr std::string_view kUniformDecls[] = {
+        "uniform vec3 iResolution;",
+        "uniform float iTime;",
+        "uniform float iTimeDelta;",
+        "uniform int iFrame;",
+        "uniform float iFrameRate;",
+        "uniform vec4 iMouse;",
+        "uniform vec4 iDate;",
+        "uniform float iSampleRate;",
+        "uniform float iChannelTime[4];",
+        "uniform vec3 iChannelResolution[4];",
+        "uniform sampler2D iChannel0;",
+        "uniform sampler2D iChannel1;",
+        "uniform sampler2D iChannel2;",
+        "uniform sampler2D iChannel3;",
+        "uniform vec2 iScreenOffset;",
+        "uniform vec2 iDesktopResolution;",
+        "uniform int iScreenIndex;",
+        "uniform int iScreenCount;",
+    };
+    static_assert(std::size(kUniformDecls) == std::size(kUniformNames));
+
+    constexpr std::string_view kPrecision = "precision highp float;\n"
+                                            "precision highp int;\n"
+                                            "precision highp sampler2D;\n";
+
+  } // namespace
+
+  std::string shaderSpec(std::string_view path) {
+    if (!isShaderPath(path)) {
+      return {};
+    }
+    return std::string(trim(path.substr(kPathPrefix.size())));
+  }
+
+  std::vector<std::filesystem::path> searchDirectories(const std::vector<std::string>& configured) {
+    std::vector<std::filesystem::path> dirs;
+    const auto add = [&dirs](const std::filesystem::path& dir) {
+      if (dir.empty()) {
+        return;
+      }
+      const auto normal = dir.lexically_normal();
+      if (std::ranges::find(dirs, normal) == dirs.end()) {
+        dirs.push_back(normal);
+      }
+    };
+    for (const auto& dir : configured) {
+      if (!trim(dir).empty()) {
+        add(FileUtils::expandUserPath(std::string(trim(dir))));
+      }
+    }
+    const std::string home = envOr("HOME", "");
+    const std::string dataHome = envOr("XDG_DATA_HOME", home.empty() ? "" : home + "/.local/share");
+    if (!dataHome.empty()) {
+      add(std::filesystem::path(dataHome) / "noctalia" / "shaders");
+    }
+    const std::string dataDirs = envOr("XDG_DATA_DIRS", "/usr/local/share:/usr/share");
+    std::size_t start = 0;
+    while (start <= dataDirs.size()) {
+      const auto end = dataDirs.find(':', start);
+      const std::string_view entry =
+          std::string_view(dataDirs).substr(start, end == std::string::npos ? std::string::npos : end - start);
+      if (!entry.empty()) {
+        add(std::filesystem::path(entry) / "noctalia" / "shaders");
+      }
+      if (end == std::string::npos) {
+        break;
+      }
+      start = end + 1;
+    }
+    return dirs;
+  }
+
+  std::optional<std::filesystem::path>
+  resolveShaderFile(std::string_view path, const std::vector<std::filesystem::path>& directories) {
+    const std::string spec = shaderSpec(path);
+    if (spec.empty()) {
+      return std::nullopt;
+    }
+    if (spec.starts_with('/') || spec.starts_with('~')) {
+      const std::filesystem::path file = FileUtils::expandUserPath(spec);
+      return isRegularFile(file) ? std::optional(file) : std::nullopt;
+    }
+    const std::filesystem::path rel(spec);
+    if (rel.is_absolute() || std::ranges::any_of(rel, [](const auto& part) { return part == ".."; })) {
+      return std::nullopt;
+    }
+    std::filesystem::path relFrag = rel;
+    relFrag += ".frag";
+    for (const auto& dir : directories) {
+      for (const auto& candidate : {dir / rel, dir / relFrag, dir / "Shaders" / relFrag}) {
+        if (isRegularFile(candidate)) {
+          return candidate;
+        }
+      }
+      std::error_code ec;
+      std::vector<std::filesystem::path> libraries;
+      for (const auto& entry : std::filesystem::directory_iterator(dir, ec)) {
+        std::error_code typeEc;
+        if (entry.is_directory(typeEc) && !typeEc) {
+          libraries.push_back(entry.path());
+        }
+      }
+      std::ranges::sort(libraries);
+      for (const auto& library : libraries) {
+        const auto candidate = library / "Shaders" / relFrag;
+        if (isRegularFile(candidate)) {
+          return candidate;
+        }
+      }
+    }
+    return std::nullopt;
+  }
+
+  SourceKind classifySource(std::string_view source) {
+    const std::string code = withoutComments(source);
+    static const std::regex kVersion(R"((^|\n)\s*#\s*version\b)");
+    static const std::regex kMain(R"(\bvoid\s+main\s*\(\s*(void\s*)?\))");
+    if (std::regex_search(code, kVersion) && std::regex_search(code, kMain)) {
+      return SourceKind::Complete;
+    }
+    return SourceKind::MainImage;
+  }
+
+  std::string assembleFragmentSource(std::string_view source) {
+    const std::string code = withoutComments(source);
+    std::string uniforms;
+    for (std::size_t i = 0; i < std::size(kUniformNames); ++i) {
+      if (!declaresUniform(code, kUniformNames[i])) {
+        uniforms += kUniformDecls[i];
+        uniforms += '\n';
+      }
+    }
+
+    if (classifySource(source) == SourceKind::Complete) {
+      // Keep the shader's own #version line first; add the uniforms right after it.
+      static const std::regex kVersionLine(R"((^|\n)(\s*#\s*version[^\n]*)\n?)");
+      const std::string text(source);
+      std::smatch match;
+      if (!std::regex_search(text, match, kVersionLine)) {
+        return text;
+      }
+      const auto versionEnd = static_cast<std::size_t>(match.position(0) + match.length(0));
+      const auto lineOfVersionEnd = static_cast<std::size_t>(
+          std::count(text.begin(), text.begin() + static_cast<std::ptrdiff_t>(versionEnd), '\n')
+      );
+      std::string out = text.substr(0, versionEnd);
+      if (!out.ends_with('\n')) {
+        out += '\n';
+      }
+      out += kPrecision;
+      out += uniforms;
+      out += "#line " + std::to_string(lineOfVersionEnd + 1) + "\n";
+      out += text.substr(versionEnd);
+      return out;
+    }
+
+    std::string out = "#version 300 es\n";
+    out += kPrecision;
+    out += "#define HW_PERFORMANCE 1\n";
+    out += uniforms;
+    out += "out vec4 noctaliaFragColor;\n";
+    out += "#line 1\n";
+    out += source;
+    if (!out.ends_with('\n')) {
+      out += '\n';
+    }
+    out += "void main() {\n"
+           "  vec4 color = vec4(0.0, 0.0, 0.0, 1.0);\n"
+           "  mainImage(color, vec2(gl_FragCoord.x, iResolution.y - gl_FragCoord.y));\n"
+           "  noctaliaFragColor = vec4(color.rgb, 1.0);\n"
+           "}\n";
+    return out;
+  }
+
+  std::string_view vertexSource() {
+    return "#version 300 es\n"
+           "void main() {\n"
+           "  vec2 p = vec2(float(gl_VertexID & 1), float(gl_VertexID >> 1)) * 4.0 - 1.0;\n"
+           "  gl_Position = vec4(p, 0.0, 1.0);\n"
+           "}\n";
+  }
+
+  std::uint64_t fnv1a(std::string_view data, std::uint64_t seed) {
+    std::uint64_t hash = seed;
+    for (const char c : data) {
+      hash ^= static_cast<unsigned char>(c);
+      hash *= 0x100000001b3ULL;
+    }
+    return hash;
+  }
+
+} // namespace shader
diff --git a/src/shell/shader/shader_source.h b/src/shell/shader/shader_source.h
new file mode 100644
index 000000000..12cefb839
--- /dev/null
+++ b/src/shell/shader/shader_source.h
@@ -0,0 +1,74 @@
+#pragma once
+
+// Pure helpers for the live "shader:" wallpaper: path syntax, file lookup and the
+// GLSL wrapper around a Shadertoy-style mainImage(). No GL here, so they are unit
+// tested directly (tests/shader_source_test.cpp).
+
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace shader {
+
+  inline constexpr std::string_view kPathPrefix = "shader:";
+
+  inline bool isShaderPath(std::string_view path) noexcept { return path.starts_with(kPathPrefix); }
+
+  // The part after "shader:", trimmed ("" when nothing follows the prefix).
+  std::string shaderSpec(std::string_view path);
+
+  // Directories searched for a shader given by name: `configured` (each expanded
+  // for "~"), then $XDG_DATA_HOME/noctalia/shaders (default ~/.local/share), then
+  // noctalia/shaders under each $XDG_DATA_DIRS entry (default /usr/local/share,
+  // /usr/share). Duplicates are dropped; directories need not exist.
+  std::vector<std::filesystem::path> searchDirectories(const std::vector<std::string>& configured);
+
+  // Resolves a "shader:" path to a fragment shader file.
+  // - "/abs/file.frag" or "~/file.frag": that file.
+  // - "name" or "sub/name": in each search directory, in order, the first that
+  //   exists of <dir>/<spec>, <dir>/<spec>.frag, <dir>/Shaders/<spec>.frag and
+  //   <dir>/<library>/Shaders/<spec>.frag for every subdirectory <library>
+  //   (sorted). The last form finds shaders in an installed library such as
+  //   KDE Shader Wallpaper's tree (<library>/Shaders/*.frag beside its Resources/).
+  // nullopt when nothing matches.
+  std::optional<std::filesystem::path>
+  resolveShaderFile(std::string_view path, const std::vector<std::filesystem::path>& directories);
+
+  // How the user source is wrapped.
+  enum class SourceKind : std::uint8_t {
+    MainImage, // Shadertoy: defines mainImage(out vec4, in vec2); we add uniforms + main()
+    Complete,  // has its own #version and main(); we only add the uniforms it does not declare
+  };
+  SourceKind classifySource(std::string_view source);
+
+  // Uniforms every shader may use (Shadertoy names, plus the KDE plugin's
+  // multi-monitor extras). Exposed for the renderer and tests.
+  inline constexpr std::string_view kUniformNames[] = {
+      "iResolution",   "iTime",
+      "iTimeDelta",    "iFrame",
+      "iFrameRate",    "iMouse",
+      "iDate",         "iSampleRate",
+      "iChannelTime",  "iChannelResolution",
+      "iChannel0",     "iChannel1",
+      "iChannel2",     "iChannel3",
+      "iScreenOffset", "iDesktopResolution",
+      "iScreenIndex",  "iScreenCount",
+  };
+
+  // Complete GLSL ES 3.00 fragment shader for `source`. fragCoord is passed to
+  // mainImage() flipped vertically, so the rendered texture stores the top row
+  // first (the order Noctalia samples), while the shader still sees Shadertoy's
+  // bottom-left origin. Errors in the user code report line numbers of the
+  // original file (#line 1 before it).
+  std::string assembleFragmentSource(std::string_view source);
+
+  // Vertex shader for the full-screen triangle (no attributes; gl_VertexID).
+  std::string_view vertexSource();
+
+  // 64-bit FNV-1a, for cache keys and still-frame names.
+  std::uint64_t fnv1a(std::string_view data, std::uint64_t seed = 0xcbf29ce484222325ULL);
+
+} // namespace shader
diff --git a/tests/shader_source_test.cpp b/tests/shader_source_test.cpp
new file mode 100644
index 000000000..3e1fd8fb1
--- /dev/null
+++ b/tests/shader_source_test.cpp
@@ -0,0 +1,140 @@
+#include "shell/shader/shader_source.h"
+#include "tests/test_check.h"
+
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <unistd.h>
+
+namespace {
+
+  namespace fs = std::filesystem;
+
+  void
+  write(const fs::path& path, const std::string& text = "void mainImage(out vec4 c, in vec2 p) { c = vec4(1); }\n") {
+    fs::create_directories(path.parent_path());
+    std::ofstream(path) << text;
+  }
+
+  bool contains(const std::string& haystack, std::string_view needle) {
+    return haystack.find(needle) != std::string::npos;
+  }
+
+  std::size_t count(const std::string& haystack, std::string_view needle) {
+    std::size_t n = 0;
+    for (auto pos = haystack.find(needle); pos != std::string::npos; pos = haystack.find(needle, pos + 1)) {
+      ++n;
+    }
+    return n;
+  }
+
+  void testPathSyntax() {
+    TEST_CHECK(shader::isShaderPath("shader:1993"));
+    TEST_CHECK(!shader::isShaderPath("sequoia:"));
+    TEST_CHECK(!shader::isShaderPath("/home/x/shader:y.png"));
+    TEST_CHECK(shader::shaderSpec("shader:  kde/1993 ") == "kde/1993");
+    TEST_CHECK(shader::shaderSpec("shader:").empty());
+    TEST_CHECK(shader::shaderSpec("color:#fff").empty());
+  }
+
+  void testResolve(const fs::path& root) {
+    const fs::path user = root / "user";
+    const fs::path system = root / "system";
+    write(user / "mine.frag");
+    write(user / "Shaders" / "flat.frag");
+    write(system / "kde" / "Shaders" / "1993.frag");
+    write(system / "kde" / "Shaders" / "mine.frag"); // shadowed by the user's copy
+    write(system / "abc" / "Shaders" / "dup.frag");
+    write(system / "kde" / "Shaders" / "dup.frag");
+    write(root / "abs.frag");
+    const std::vector<fs::path> dirs = {user, system};
+
+    TEST_CHECK(shader::resolveShaderFile("shader:mine", dirs) == user / "mine.frag");
+    TEST_CHECK(shader::resolveShaderFile("shader:mine.frag", dirs) == user / "mine.frag");
+    TEST_CHECK(shader::resolveShaderFile("shader:flat", dirs) == user / "Shaders" / "flat.frag");
+    TEST_CHECK(shader::resolveShaderFile("shader:1993", dirs) == system / "kde" / "Shaders" / "1993.frag");
+    TEST_CHECK(shader::resolveShaderFile("shader:kde/Shaders/1993", dirs) == system / "kde" / "Shaders" / "1993.frag");
+    // Libraries are searched in name order.
+    TEST_CHECK(shader::resolveShaderFile("shader:dup", dirs) == system / "abc" / "Shaders" / "dup.frag");
+    TEST_CHECK(shader::resolveShaderFile("shader:" + (root / "abs.frag").string(), dirs) == root / "abs.frag");
+    TEST_CHECK(!shader::resolveShaderFile("shader:missing", dirs).has_value());
+    TEST_CHECK(!shader::resolveShaderFile("shader:../user/mine", {system}).has_value());
+    TEST_CHECK(!shader::resolveShaderFile("shader:", dirs).has_value());
+  }
+
+  void testSearchDirectories(const fs::path& root) {
+    ::setenv("XDG_DATA_HOME", (root / "data").c_str(), 1);
+    ::setenv("XDG_DATA_DIRS", (root / "a").string().append(":").append((root / "b").string()).c_str(), 1);
+    const auto dirs = shader::searchDirectories({(root / "custom").string(), "", (root / "custom").string()});
