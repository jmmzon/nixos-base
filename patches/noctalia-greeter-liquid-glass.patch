diff --git a/src/render/scene/custom_draw_node.h b/src/render/scene/custom_draw_node.h
new file mode 100644
index 0000000..0170f56
--- /dev/null
+++ b/src/render/scene/custom_draw_node.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include "render/core/mat3.h"
+#include "render/scene/node.h"
+
+class RenderBackend;
+
+struct CustomDrawContext {
+  // Surface size in logical pixels.
+  float surfaceWidth = 0.0f;
+  float surfaceHeight = 0.0f;
+  // Buffer pixels per logical pixel.
+  float pixelScaleX = 1.0f;
+  float pixelScaleY = 1.0f;
+  Mat3 transform = Mat3::identity();
+  // Node opacity multiplied by every ancestor's.
+  float opacity = 1.0f;
+  float width = 0.0f;
+  float height = 0.0f;
+};
+
+// A node that paints itself through the backend instead of a built-in primitive. RenderContext
+// calls draw() with the clip already applied; children render afterwards as usual.
+class CustomDrawNode : public Node {
+public:
+  CustomDrawNode() : Node(NodeType::CustomDraw) {}
+
+  virtual void draw(RenderBackend& backend, const CustomDrawContext& context) const = 0;
+};
diff --git a/src/render/scene/liquid_glass_node.cpp b/src/render/scene/liquid_glass_node.cpp
new file mode 100644
index 0000000..618aa44
--- /dev/null
+++ b/src/render/scene/liquid_glass_node.cpp
@@ -0,0 +1,25 @@
+#include "render/scene/liquid_glass_node.h"
+
+#include "render/backend/render_backend.h"
+#include "render/programs/liquid_glass_program.h"
+
+void LiquidGlassNode::draw(RenderBackend& backend, const CustomDrawContext& context) const {
+  auto& program = LiquidGlassProgram::instance();
+  program.ensureInitialized();
+  program.draw(
+      backend,
+      LiquidGlassProgram::Params{
+          .surfaceWidth = context.surfaceWidth,
+          .surfaceHeight = context.surfaceHeight,
+          .pixelScaleX = context.pixelScaleX,
+          .pixelScaleY = context.pixelScaleY,
+          .width = context.width,
+          .height = context.height,
+          .radius = m_radius,
+          .opacity = context.opacity,
+          .tint = rgba(m_tint.r * m_tint.a, m_tint.g * m_tint.a, m_tint.b * m_tint.a, m_tint.a),
+          .frostRadius = m_frostRadius,
+          .transform = context.transform,
+      }
+  );
+}
diff --git a/src/render/scene/liquid_glass_node.h b/src/render/scene/liquid_glass_node.h
new file mode 100644
index 0000000..daf8c85
--- /dev/null
+++ b/src/render/scene/liquid_glass_node.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "render/core/color.h"
+#include "render/scene/custom_draw_node.h"
+
+// Liquid glass over what the scene has already drawn under this node's rounded rectangle.
+// Put it right before the panel it backs, in the same parent and z-index.
+class LiquidGlassNode : public CustomDrawNode {
+public:
+  void setRadius(float radius) {
+    if (m_radius == radius) {
+      return;
+    }
+    m_radius = radius;
+    markPaintDirty();
+  }
+
+  // Straight-alpha colour laid over the glass body.
+  void setTint(const Color& tint) {
+    if (m_tint == tint) {
+      return;
+    }
+    m_tint = tint;
+    markPaintDirty();
+  }
+
+  void setFrostRadius(float radius) {
+    if (m_frostRadius == radius) {
+      return;
+    }
+    m_frostRadius = radius;
+    markPaintDirty();
+  }
+
+  void draw(RenderBackend& backend, const CustomDrawContext& context) const override;
+
+private:
+  float m_radius = 0.0F;
+  float m_frostRadius = 10.0F;
+  Color m_tint = rgba(0.0F, 0.0F, 0.0F, 0.0F);
+};
